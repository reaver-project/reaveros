#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]
then
    printf 'usage: %s <architecture> <build-environment image> [configuration]\n' "$0" >&2
    exit 2
fi

architecture=$1
build_environment=$2
configuration=${3:-}
repo_root=$(git rev-parse --show-toplevel)

case $(uname -m) in
    x86_64) host_architecture=amd64 ;;
    aarch64) host_architecture=aarch64 ;;
    *) host_architecture=unsupported ;;
esac
if [[ ${architecture} != "${host_architecture}" ]]
then
    printf 'Cannot execute %s unit tests on a %s host.\n' \
        "${architecture}" "${host_architecture}" >&2
    exit 2
fi

docker run --rm \
    --volume "${repo_root}:/reaveros:ro" \
    "${build_environment}" \
    /usr/bin/env bash -c '
        set -euo pipefail
        architecture=$1
        configuration=$2
        cd /build
        cmake /reaveros -DREAVEROS_ENABLE_UNIT_TESTS=ON \
            -DREAVEROS_ARCHITECTURES="${architecture}" \
            -DCMAKE_BUILD_TYPE="${configuration}"
        make "all-${architecture}-build-tests" -j"$(nproc)"
        ctest --output-on-failure -j"$(nproc)"
    ' -- "${architecture}" "${configuration}"
