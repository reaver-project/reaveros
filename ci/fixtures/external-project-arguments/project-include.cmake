function(_record_toolchain_arguments)
    set(_records "{}")
    foreach (_project toolchain-cmake toolchain-llvm toolchain-thorn toolchain-dosfstools toolchain-mtools)
        get_property(_separator TARGET ${_project} PROPERTY _EP_LIST_SEPARATOR)
        set(_entry "{}")
        foreach (_kind CMAKE_ARGS CONFIGURE_COMMAND)
            get_property(_arguments TARGET ${_project} PROPERTY _EP_${_kind})
            set(_array "[]")
            set(_index 0)
            foreach (_argument IN LISTS _arguments)
                string(REPLACE "${_separator}" ";" _argument "${_argument}")
                _reaveros_json_string(_quoted "${_argument}")
                string(JSON _array SET "${_array}" ${_index} "${_quoted}")
                math(EXPR _index "${_index} + 1")
            endforeach()
            string(JSON _entry SET "${_entry}" ${_kind} "${_array}")
        endforeach()
        string(JSON _records SET "${_records}" ${_project} "${_entry}")
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/toolchain-arguments.json" "${_records}\n")
endfunction()
cmake_language(DEFER CALL _record_toolchain_arguments)
