#!/usr/bin/env python3

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


repository = Path(__file__).resolve().parent.parent
fixture = repository / "ci/fixtures/images"
if len(sys.argv) > 2:
    sys.exit("usage: test-images [installed toolchain directory for real CPIO/FAT tests]")
real = len(sys.argv) == 2
real_tools = {}
if real:
    toolchain = Path(sys.argv[1]).resolve()
    real_tools = {name: str(toolchain / relative) for name, relative in (
        ("mkfs.fat", "dosfstools/sbin/mkfs.fat"), ("mcopy", "mtools/bin/mcopy"), ("mmd", "mtools/bin/mmd"))}
    for name in ("find", "cpio", "fallocate"):
        real_tools[name] = shutil.which(name)
    if not all(path and os.access(path, os.X_OK) for path in real_tools.values()):
        sys.exit("Real image tests require installed FAT tools, find, cpio, and fallocate.")


def run(*command, env=None, cwd=None, data=None, succeeds=True):
    result = subprocess.run(command, input=data, env=env, cwd=cwd,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    output = result.stdout.decode(errors="replace")
    if (result.returncode == 0) != succeeds:
        raise AssertionError(output)
    return output


with tempfile.TemporaryDirectory(prefix="image rules with spaces ") as temporary:
    root = Path(temporary)
    source = root / "source with spaces"
    shutil.copytree(fixture, source)
    # Exercise source paths containing quotes, literal dollars, and spaces.
    repository_link = root / "repo with 'quotes' and $dollars"
    repository_link.symlink_to(repository, target_is_directory=True)
    config = source / "loaders/uefi/config/reaveros.conf"
    config.parent.mkdir(parents=True)
    shutil.copyfile(repository / "loaders/uefi/config/reaveros.conf", config)
    build = root / "build with 'quotes' and $dollars"
    payload = root / "payload with spaces"
    services = payload / "services/system"
    services.mkdir(parents=True)
    logger = services / "logger.srv"
    logger.write_bytes(b"first service\n")
    awkward = services / "a 'quoted' $service with\nnewline.srv"
    awkward.write_bytes(b"another service\n")
    bin_directory = root / "bin with spaces"
    bin_directory.mkdir()
    for name in ("find", "cpio", "fallocate"):
        (bin_directory / name).symlink_to(fixture / "tool-proxy.py")
    run("cmake", "-S", str(source), "-B", str(build), "-G", "Unix Makefiles",
        "-DTEST_REPOSITORY=" + str(repository_link), "-DTEST_PAYLOAD=" + str(payload),
        *("-DREAVEROS_HOST_" + name.upper() + "=" + str(bin_directory / name)
            for name in ("find", "cpio", "fallocate")))
    installed = {}
    for name, relative in (
        ("librosestd", "sysroots/amd64-hosted/usr/lib/librosestd.so"),
        ("loader", "loaders/uefi-amd64/loader-uefi"), ("kernel", "kernels/amd64/kernel")):
        path = build / "install" / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes((name + " fixture\n").encode())
        installed[name] = path
    for name, relative in (("mkfs.fat", "dosfstools/sbin"), ("mcopy", "mtools/bin"), ("mmd", "mtools/bin")):
        path = build / "install/toolchain" / relative / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(fixture / "tool-proxy.py")
    log = root / "tool calls.jsonl"
    env = dict(os.environ, PATH=str(bin_directory) + os.pathsep + os.environ["PATH"],
        IMAGE_TEST_LOG=str(log), IMAGE_TEST_REAL_TOOLS=json.dumps(real_tools))
    initrd = build / "install/images/initrd-amd64.img"
    fat = build / "install/images/uefi-efipart-amd64.img"

    def make(target="joint-images", failure=None, succeeds=True):
        log.write_text("")
        return run("make", "-C", str(build), "-j8", target,
            env=dict(env, IMAGE_TEST_FAIL=failure or ""), succeeds=succeeds)

    def calls(name):
        return [call for line in log.read_text().splitlines()
            if (call := json.loads(line))[0] == name]

    def inspect():
        assert fat.stat().st_size == 1474560
        if not real:
            names = json.loads(initrd.read_bytes())
            assert str(Path("system") / awkward.name) in names, names
            return
        def inspect_archive(data, extracted):
            shutil.rmtree(extracted, ignore_errors=True)
            extracted.mkdir()
            run(real_tools["cpio"], "--extract", "--make-directories", "--no-absolute-filenames",
                cwd=extracted, data=data)
            for original, relative in ((logger, "system/logger.srv"),
                    (awkward, "system/" + awkward.name), (installed["librosestd"], "librosestd.so")):
                assert (extracted / relative).read_bytes() == original.read_bytes(), relative
        inspect_archive(initrd.read_bytes(), root / "extracted")
        for original, relative in ((installed["loader"], "EFI/BOOT/BOOTX64.EFI"),
                (config, "EFI/BOOT/reaveros.conf"), (installed["kernel"], "reaver/kernel.img"),
                (initrd, "reaver/initrd.img")):
            destination = root / "copied from FAT"
            destination.unlink(missing_ok=True)
            run(real_tools["mcopy"], "-i", fat.name, "::/" + relative, str(destination), cwd=fat.parent)
            assert destination.read_bytes() == original.read_bytes(), relative
        run(str(toolchain / "dosfstools/sbin/fsck.fat"), "-n", str(fat))

    output = make()
    assert output.count("Staging fixture services") == 1, output
    assert output.count("Packaging initrd for amd64") == 1, output
    assert output.count("Packaging UEFI filesystem for amd64") == 1, output
    assert len(calls("cpio")) == len(calls("mkfs.fat")) == len(calls("mmd")) == 1
    assert [call[-2:] for call in calls("mcopy")] == [[name, "::/" + name] for name in (
        "EFI/BOOT/BOOTX64.EFI", "EFI/BOOT/reaveros.conf", "reaver/kernel.img", "reaver/initrd.img")]
    inspect()

    # CMake's top-level Makefile can traverse a separate recursive dependency
    # graph for each explicit goal. Preserve per-request rebuilding there too.
    for goals in (("image-initrd-amd64", "image-uefi-efipart-amd64"),
            ("image-uefi-efipart-amd64", "image-initrd-amd64")):
        log.write_text("")
        run("make", "-C", str(build), "-j8", *goals, env=env)
        assert len(calls("mkfs.fat")) == 1 and len(calls("mcopy")) == 4
        print("Direct image goals: " + ", ".join(goals) +
            "; initrd packaging runs: " + str(len(calls("cpio"))))
        inspect()

    # Every request runs packaging, including unchanged inputs and reconfigure.
    for reconfigure in (False, True):
        if reconfigure:
            run("cmake", "-S", str(source), "-B", str(build))
        for image in (initrd, fat):
            os.utime(image, (1, 1))
        make()
        assert all(image.stat().st_mtime_ns > 1000000000 for image in (initrd, fat))
        assert len(calls("cpio")) == 1
    initrd.unlink()
    fat.unlink()
    make("image-uefi-efipart-amd64")
    assert initrd.is_file() and fat.is_file()
    logger.write_bytes(b"changed service\n")
    obsolete = services / "obsolete.srv"
    obsolete.write_bytes(b"remove me\n")
    make()
    obsolete.unlink()
    make()
    assert not (build / "images/initrd-amd64/system/obsolete.srv").exists()
    inspect()

    # Check both sides of the pipeline and each FAT tool. Failed attempts must
    # neither publish partial images nor reach later tools; retries must recover.
    for failed in ("find", "cpio", "fallocate", "mkfs.fat", "mmd", "mcopy"):
        previous = fat.read_bytes() if failed not in ("find", "cpio") else initrd.read_bytes()
        image = fat if failed not in ("find", "cpio") else initrd
        assert "Intentional image tool failure" in make(failure=failed, succeeds=False)
        assert image.read_bytes() == previous, failed
        if failed in ("find", "cpio"):
            assert not Path(str(initrd) + ".tmp").exists()
            assert not calls("mkfs.fat")
        if failed in ("fallocate", "mkfs.fat", "mmd"):
            assert not calls("mcopy")
        make()

    completed_fat = fat.read_bytes()
    output = make(failure="bad-format", succeeds=False)
    assert "mkfs did not produce a FAT boot sector" in output, output
    assert not calls("mcopy") and fat.read_bytes() == completed_fat
    make()

    # Exact boundary for this fixed layout: three directory clusters and the
    # rounded loader/config/initrd allocations leave the remainder for kernel.
    original_kernel = installed["kernel"].read_bytes()
    other_clusters = 3 + sum((path.stat().st_size + 511) // 512
        for path in (installed["loader"], config, initrd))
    with installed["kernel"].open("wb") as stream:
        stream.truncate((2847 - other_clusters) * 512)
    output = make()
    assert "2847/2847 clusters used" in output, output
    inspect()
    completed_fat = fat.read_bytes()
    with installed["kernel"].open("ab") as stream:
        stream.write(b"x")
    output = make(succeeds=False)
    assert "payload needs 2848 clusters" in output, output
    assert not calls("mcopy") and fat.read_bytes() == completed_fat
    installed["kernel"].write_bytes(original_kernel)
    make()

    # Failed staging is also a failed build, without publishing a new image.
    completed_fat = fat.read_bytes()
    loader_contents = installed["loader"].read_bytes()
    installed["loader"].unlink()
    make(succeeds=False)
    assert fat.read_bytes() == completed_fat and not calls("mkfs.fat")
    installed["loader"].write_bytes(loader_contents)
    make()
    run("make", "-C", str(build), "clean")
    assert not initrd.exists() and not fat.exists()
    make()
    inspect()

print(("Real CPIO/FAT" if real else "Mock image-rule") +
    " tests pass: shared producers, rebuilds, paths, payloads, capacity, failures, and recovery.")
