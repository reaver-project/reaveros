#!/usr/bin/env bash

set -euo pipefail

if [[ $(basename -- "$0") == aws ]]
then
    {
        printf 'aws'
        printf '\t%s' "$@"
        printf '\n'
    } >> "${PUBLISH_TEST_LOG}"
    if [[ $1 == ecr && $2 == get-login-password ]]
    then
        printf 'password\n'
        exit
    fi
    printf 'Unexpected AWS call: %s %s\n' "$1" "$2" >&2
    exit 2
fi

if [[ $(basename -- "$0") == skopeo ]]
then
    {
        printf 'skopeo'
        printf '\t%s' "$@"
        printf '\n'
    } >> "${PUBLISH_TEST_LOG}"
    if [[ $1 == login ]]
    then
        cat > /dev/null
    elif [[ $1 == inspect ]]
    then
        reference=${*: -1}
        state_file=$(printf '%s' "${reference}" | sha256sum | cut -d ' ' -f 1)
        cat "${PUBLISH_TEST_STATE}/${state_file}"
    elif [[ $1 == copy ]]
    then
        source=${*: -2:1}
        destination=${*: -1}
        source_file=$(printf '%s' "${source}" | sha256sum | cut -d ' ' -f 1)
        destination_file=$(printf '%s' "${destination}" | sha256sum | cut -d ' ' -f 1)
        cp "${PUBLISH_TEST_STATE}/${source_file}" \
            "${PUBLISH_TEST_STATE}/${destination_file}"
    fi
    exit
fi

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
test_directory=$(mktemp -d)
mkdir "${test_directory}/bin"
ln -s "${self_dir}/test-publish-build-environment" "${test_directory}/bin/aws"
ln -s "${self_dir}/test-publish-build-environment" "${test_directory}/bin/skopeo"
export PATH="${test_directory}/bin:${PATH}"
export AWS_REGION=us-west-2
export GHCR_TOKEN=example-token
export GITHUB_ACTOR=reaver-project
export PUBLISH_TEST_LOG="${test_directory}/calls"
export PUBLISH_TEST_STATE="${test_directory}/published"
mkdir "${PUBLISH_TEST_STATE}"
: > "${PUBLISH_TEST_LOG}"

cleanup()
{
    rm -rf "${test_directory}"
}
trap cleanup EXIT

content_tag=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
source_image=registry.example/reaveros
source_unpruned_image=registry.example/reaveros-unpruned
destination_image=ghcr.io/reaver-project/reaveros-build-env
destination_unpruned_image=ghcr.io/reaver-project/reaveros-build-env/unpruned
run_tag=ci-run-101-1

state_file()
{
    printf '%s' "docker://$1:$2" | sha256sum | cut -d ' ' -f 1
}

printf '{"manifest":"pruned"}' > \
    "${PUBLISH_TEST_STATE}/$(state_file "${source_image}" "${run_tag}")"
printf '{"manifest":"unpruned"}' > \
    "${PUBLISH_TEST_STATE}/$(state_file "${source_unpruned_image}" "${run_tag}")"

"${self_dir}/publish-build-environment" \
    "${source_image}" \
    "${source_unpruned_image}" \
    "${destination_image}" \
    "${destination_unpruned_image}" \
    "${content_tag}" \
    "${run_tag}"

assert_log_count()
{
    expected=$1
    pattern=$2
    actual=$(grep --fixed-strings --count "${pattern}" "${PUBLISH_TEST_LOG}" || true)
    if [[ ${actual} -ne ${expected} ]]
    then
        printf 'Expected %s calls matching %s, found %s.\n' \
            "${expected}" "${pattern}" "${actual}" >&2
        cat "${PUBLISH_TEST_LOG}" >&2
        exit 1
    fi
}

assert_log_count 1 $'aws\tecr\tget-login-password'
assert_log_count 2 $'skopeo\tlogin'
assert_log_count 6 $'skopeo\tcopy'

assert_destinations_match_sources()
{
    local index tag destination source
    local -a destinations=("${destination_image}" "${destination_unpruned_image}")
    local -a sources=("${source_image}" "${source_unpruned_image}")
    for index in "${!destinations[@]}"
    do
        source="${PUBLISH_TEST_STATE}/$(state_file "${sources[index]}" "${run_tag}")"
        for tag in "${content_tag}" "${run_tag}" latest
        do
            destination="${PUBLISH_TEST_STATE}/$(state_file "${destinations[index]}" "${tag}")"
            if ! cmp --silent "${source}" "${destination}"
            then
                printf 'Publication did not copy %s:%s from its source.\n' \
                    "${destinations[index]}" "${tag}" >&2
                exit 1
            fi
        done
    done
}
assert_destinations_match_sources

: > "${PUBLISH_TEST_LOG}"
"${self_dir}/publish-build-environment" \
    "${source_image}" \
    "${source_unpruned_image}" \
    "${destination_image}" \
    "${destination_unpruned_image}" \
    "${content_tag}" \
    "${run_tag}"
assert_log_count 0 $'skopeo\tcopy'

printf '{"manifest":"wrong"}' > \
    "${PUBLISH_TEST_STATE}/$(state_file "${destination_unpruned_image}" latest)"
: > "${PUBLISH_TEST_LOG}"
"${self_dir}/publish-build-environment" \
    "${source_image}" \
    "${source_unpruned_image}" \
    "${destination_image}" \
    "${destination_unpruned_image}" \
    "${content_tag}" \
    "${run_tag}"
assert_log_count 6 $'skopeo\tcopy'
assert_destinations_match_sources

for tag in "${content_tag}" "${run_tag}" latest
do
    printf '{"manifest":"wrong"}' > \
        "${PUBLISH_TEST_STATE}/$(state_file "${destination_image}" "${tag}")"
done
: > "${PUBLISH_TEST_LOG}"
"${self_dir}/publish-build-environment" \
    "${source_image}" \
    "${source_unpruned_image}" \
    "${destination_image}" \
    "${destination_unpruned_image}" \
    "${content_tag}" \
    "${run_tag}"
assert_log_count 6 $'skopeo\tcopy'
assert_destinations_match_sources

: > "${PUBLISH_TEST_LOG}"
if "${self_dir}/publish-build-environment" \
    "${source_image}" \
    "${source_unpruned_image}" \
    "${destination_image}" \
    "${destination_unpruned_image}" \
    invalid "${run_tag}" > /dev/null 2>&1
then
    printf 'Publication accepted an invalid content tag.\n' >&2
    exit 1
fi
if [[ -s ${PUBLISH_TEST_LOG} ]]
then
    printf 'Publication contacted a registry after rejecting its input.\n' >&2
    exit 1
fi

printf 'Build-environment publication tests passed.\n'
