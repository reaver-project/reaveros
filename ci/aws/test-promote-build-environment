#!/usr/bin/env bash

set -euo pipefail

if [[ $(basename -- "$0") == aws ]]
then
    {
        printf 'aws'
        printf '\t%s' "$@"
        printf '\n'
    } >> "${PROMOTION_TEST_LOG}"

    case $1:$2 in
        ecr:get-login-password)
            printf 'password\n'
            ;;
        ecr:wait)
            if [[ ${PROMOTION_TEST_CASE} == scan-timeout ]]
            then
                exit 255
            fi
            ;;
        ecr:describe-image-scan-findings)
            if [[ ${PROMOTION_TEST_CASE} == findings-error ]]
            then
                exit 254
            elif [[ ${PROMOTION_TEST_CASE} == critical-findings ]]
            then
                printf '%s\n' '{"imageScanStatus":{"status":"COMPLETE"},"imageScanFindings":{"findingSeverityCounts":{"CRITICAL":1,"HIGH":2},"findings":[{"severity":"CRITICAL","description":"curl vulnerability","attributes":[{"key":"package_name","value":"curl"},{"key":"package_version","value":"8.14.1"}]},{"severity":"HIGH"},{"severity":"HIGH"}]}}'
            elif [[ ${PROMOTION_TEST_CASE} == mixed-critical ]]
            then
                jq -nc '{imageScanStatus:{status:"COMPLETE"},imageScanFindings:{findingSeverityCounts:{CRITICAL:2,HIGH:2},findings:[{severity:"CRITICAL",description:"In the Linux kernel, a runtime vulnerability was fixed.",attributes:[{key:"package_name",value:"linux"},{key:"package_version",value:"6.12.107-1"}]},{severity:"CRITICAL",description:"curl vulnerability",attributes:[{key:"package_name",value:"curl"},{key:"package_version",value:"8.14.1"}]},{severity:"HIGH"},{severity:"HIGH"}]}}'
            elif [[ ${PROMOTION_TEST_CASE} == header-only-critical ||
                ${PROMOTION_TEST_CASE} == mismatched-count ||
                ${PROMOTION_TEST_CASE} == non-kernel-linux-finding ||
                ${PROMOTION_TEST_CASE} == missing-linux-version ||
                ${PROMOTION_TEST_CASE} == duplicate-linux-version ]]
            then
                count=1
                description='In the Linux kernel, a runtime vulnerability was fixed.'
                version=6.12.107-1
                duplicate_version=false
                if [[ ${PROMOTION_TEST_CASE} == mismatched-count ]]
                then
                    count=2
                elif [[ ${PROMOTION_TEST_CASE} == non-kernel-linux-finding ]]
                then
                    description='Linux userspace header vulnerability.'
                elif [[ ${PROMOTION_TEST_CASE} == missing-linux-version ]]
                then
                    version=
                elif [[ ${PROMOTION_TEST_CASE} == duplicate-linux-version ]]
                then
                    duplicate_version=true
                fi
                jq -nc --arg description "${description}" --arg version "${version}" \
                    --argjson count "${count}" --argjson duplicate "${duplicate_version}" \
                    '{imageScanStatus:{status:"COMPLETE"},imageScanFindings:{findingSeverityCounts:{CRITICAL:$count,HIGH:2},findings:[{severity:"CRITICAL",description:$description,attributes:([{key:"package_name",value:"linux"},{key:"package_version",value:$version}] + (if $duplicate then [{key:"package_version",value:""}] else [] end))},{severity:"HIGH"},{severity:"HIGH"}]}}'
            elif [[ ${PROMOTION_TEST_CASE} == incomplete-report ]]
            then
                printf '%s\n' '{"imageScanStatus":{"status":"IN_PROGRESS"},"imageScanFindings":{"findingSeverityCounts":{},"findings":[]}}'
            elif [[ ${PROMOTION_TEST_CASE} == mismatched-high ]]
            then
                printf '%s\n' '{"imageScanStatus":{"status":"COMPLETE"},"imageScanFindings":{"findingSeverityCounts":{"HIGH":2},"findings":[{"severity":"HIGH"}]}}'
            elif [[ ${PROMOTION_TEST_CASE} == missing-severity ]]
            then
                printf '%s\n' '{"imageScanStatus":{"status":"COMPLETE"},"imageScanFindings":{"findingSeverityCounts":{"HIGH":1},"findings":[{}]}}'
            else
                printf '%s\n' '{"imageScanStatus":{"status":"COMPLETE"},"imageScanFindings":{"findingSeverityCounts":{"HIGH":2},"findings":[{"severity":"HIGH"},{"severity":"HIGH"}]}}'
            fi
            ;;
        ecr:describe-images)
            while [[ $# -gt 0 ]]
            do
                if [[ $1 == --repository-name ]]
                then
                    repository=$2
                    break
                fi
                shift
            done
            if [[ ${repository:-} == *-staging ||
                ${PROMOTION_TEST_CASE} == existing-image ]]
            then
                printf 'sha256:source\n'
            elif [[ ${PROMOTION_TEST_CASE} == conflicting-image ]]
            then
                printf 'sha256:other\n'
            else
                exit 254
            fi
            ;;
        *)
            printf 'Unexpected AWS call: %s %s\n' "$1" "$2" >&2
            exit 2
            ;;
    esac
    exit
fi

if [[ $(basename -- "$0") == skopeo ]]
then
    {
        printf 'skopeo'
        printf '\t%s' "$@"
        printf '\n'
    } >> "${PROMOTION_TEST_LOG}"
    if [[ $1 == login ]]
    then
        cat > /dev/null
    fi
    exit
fi

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
test_directory=$(mktemp -d)
mkdir "${test_directory}/bin"
ln -s "${self_dir}/test-promote-build-environment" "${test_directory}/bin/aws"
ln -s "${self_dir}/test-promote-build-environment" "${test_directory}/bin/skopeo"
export PATH="${test_directory}/bin:${PATH}"
export AWS_REGION=us-west-2
export PROMOTION_TEST_LOG="${test_directory}/calls"

cleanup()
{
    rm -rf "${test_directory}"
}
trap cleanup EXIT

run_promotion()
{
    "${self_dir}/promote-build-environment" \
        registry.example/reaveros-staging \
        registry.example/reaveros-unpruned-staging \
        registry.example/reaveros-candidate \
        registry.example/reaveros-unpruned-candidate \
        registry.example/reaveros \
        registry.example/reaveros-unpruned \
        run-101-1 \
        0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef \
        true
}

assert_log_count()
{
    expected=$1
    pattern=$2
    actual=$(grep --fixed-strings --count "${pattern}" "${PROMOTION_TEST_LOG}" || true)
    if [[ ${actual} -ne ${expected} ]]
    then
        printf 'Expected %s calls matching %s, found %s.\n' \
            "${expected}" "${pattern}" "${actual}" >&2
        cat "${PROMOTION_TEST_LOG}" >&2
        exit 1
    fi
}

export PROMOTION_TEST_CASE=high-findings
: > "${PROMOTION_TEST_LOG}"
run_promotion > /dev/null
assert_log_count 2 $'aws\tecr\twait\timage-scan-complete'
assert_log_count 2 $'aws\tecr\tdescribe-image-scan-findings'
assert_log_count 6 $'skopeo\tcopy'
assert_log_count 1 'docker://registry.example/reaveros:ci-run-101-1'
assert_log_count 1 'docker://registry.example/reaveros-unpruned:ci-run-101-1'

export PROMOTION_TEST_CASE=header-only-critical
: > "${PROMOTION_TEST_LOG}"
run_promotion > /dev/null
assert_log_count 6 $'skopeo\tcopy'

export PROMOTION_TEST_CASE=existing-image
: > "${PROMOTION_TEST_LOG}"
run_promotion > /dev/null
assert_log_count 2 $'skopeo\tcopy'

export PROMOTION_TEST_CASE=conflicting-image
: > "${PROMOTION_TEST_LOG}"
if run_promotion > /dev/null 2>&1
then
    printf 'Promotion accepted a conflicting immutable production tag.\n' >&2
    exit 1
fi
assert_log_count 0 $'skopeo\tcopy'

for failure_case in \
    scan-timeout findings-error incomplete-report critical-findings \
    mixed-critical non-kernel-linux-finding missing-linux-version \
    duplicate-linux-version mismatched-count mismatched-high missing-severity
do
    export PROMOTION_TEST_CASE=${failure_case}
    : > "${PROMOTION_TEST_LOG}"
    if run_promotion > /dev/null 2>&1
    then
        printf 'Promotion accepted the %s test case.\n' "${failure_case}" >&2
        exit 1
    fi
    assert_log_count 0 $'skopeo\tcopy'
done

printf 'Build-environment promotion tests passed.\n'
