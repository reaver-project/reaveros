#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 5 ]]
then
    printf '%s\n' \
        "usage: $0 <source image> <source unpruned image>" \
        '    <destination image> <destination unpruned image> <content tag>' >&2
    exit 2
fi
if [[ -z ${AWS_REGION:-} || -z ${GHCR_TOKEN:-} || -z ${GITHUB_ACTOR:-} ]]
then
    printf 'AWS_REGION, GHCR_TOKEN, and GITHUB_ACTOR must be set.\n' >&2
    exit 1
fi

source_image=$1
source_unpruned_image=$2
destination_image=$3
destination_unpruned_image=$4
content_tag=$5

if [[ ! ${content_tag} =~ ^[0-9a-f]{64}$ ]]
then
    printf 'Invalid content tag: %s\n' "${content_tag}" >&2
    exit 2
fi

auth_file=$(mktemp)
cleanup()
{
    rm -f "${auth_file}"
}
trap cleanup EXIT

registry=${source_image%%/*}
aws ecr get-login-password --region "${AWS_REGION}" \
    | skopeo login \
        --authfile "${auth_file}" \
        --username AWS \
        --password-stdin \
        "${registry}"
printf '%s' "${GHCR_TOKEN}" \
    | skopeo login \
        --authfile "${auth_file}" \
        --username "${GITHUB_ACTOR}" \
        --password-stdin \
        ghcr.io

copy_image()
{
    source=$1
    destination=$2
    for destination_tag in "${content_tag}" latest
    do
        skopeo copy \
            --all \
            --authfile "${auth_file}" \
            "docker://${source}:${content_tag}" \
            "docker://${destination}:${destination_tag}"
    done
}

copy_image "${source_image}" "${destination_image}"
copy_image "${source_unpruned_image}" "${destination_unpruned_image}"
