#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
test_directory=$(mktemp -d)
mkdir "${test_directory}/bin"
printf '#!/usr/bin/env bash\nexit 0\n' > "${test_directory}/bin/gh"
chmod +x "${test_directory}/bin/gh"
export PATH="${test_directory}/bin:${PATH}"

cleanup()
{
    rm -rf "${test_directory}"
}
trap cleanup EXIT

run_case()
{
    name=$1
    expected=$2
    event=$3
    expected_repository=${4:-}
    event_path="${test_directory}/${name}.json"
    output_path="${test_directory}/${name}.output"

    printf '%s\n' "${event}" > "${event_path}"
    GITHUB_EVENT_NAME=pull_request_target \
    GITHUB_EVENT_PATH="${event_path}" \
    GITHUB_OUTPUT="${output_path}" \
    GITHUB_REF_NAME=main \
    GITHUB_REPOSITORY=reaver-project/reaveros \
    GITHUB_SHA=base \
        "${self_dir}/authorize" >/dev/null

    actual=$(awk -F= '/^approved=/{ print $2 }' "${output_path}")
    actual_repository=$(awk -F= '/^source_repository=/{ print $2 }' "${output_path}")
    if [[ ${actual} != "${expected}" \
        || ( -n ${expected_repository} \
            && ${actual_repository} != "${expected_repository}" ) ]]
    then
        printf '%s: expected approved=%s, repository=%s; got %s, %s\n' \
            "${name}" \
            "${expected}" \
            "${expected_repository}" \
            "${actual}" \
            "${actual_repository}" >&2
        exit 1
    fi
}

run_dispatch_case()
{
    source_ref=$1
    expected_approved=$2
    expected_publish=$3
    event_path="${test_directory}/dispatch-${source_ref}.json"
    output_path="${test_directory}/dispatch-${source_ref}.output"

    jq --null-input \
        --arg default_branch main \
        '{inputs: {refresh_build_environment: "false"}, repository: {default_branch: $default_branch}}' \
        > "${event_path}"
    GITHUB_EVENT_NAME=workflow_dispatch \
    GITHUB_EVENT_PATH="${event_path}" \
    GITHUB_OUTPUT="${output_path}" \
    GITHUB_REF_NAME="${source_ref}" \
    GITHUB_REPOSITORY=reaver-project/reaveros \
    GITHUB_SHA=dispatch \
        "${self_dir}/authorize" >/dev/null

    actual_approved=$(awk -F= '/^approved=/{ print $2 }' "${output_path}")
    actual_publish=$(awk -F= '/^publish_cache=/{ print $2 }' "${output_path}")
    if [[ ${actual_approved} != "${expected_approved}" ]] \
        || [[ ${actual_publish} != "${expected_publish}" ]]
    then
        printf '%s\n' \
            "dispatch-${source_ref}: expected approved=${expected_approved}, publish_cache=${expected_publish};" \
            "    got approved=${actual_approved}, publish_cache=${actual_publish}" >&2
        exit 1
    fi
}

same_repository=$(jq --null-input --compact-output '{
    action: "opened",
    pull_request: {
        author_association: "NONE",
        draft: false,
        head: {ref: "feature", repo: {full_name: "reaver-project/reaveros"}, sha: "abc"},
        labels: [],
        number: 1,
        user: {login: "automation"}
    }
}')
run_case same-repository true "${same_repository}" reaver-project/reaveros

collaborator_fork=$(jq --null-input --compact-output '{
    action: "opened",
    pull_request: {
        author_association: "COLLABORATOR",
        draft: false,
        head: {ref: "feature", repo: {full_name: "collaborator/reaveros"}, sha: "def"},
        labels: [],
        number: 2,
        user: {login: "collaborator"}
    }
}')
run_case collaborator-fork true "${collaborator_fork}" collaborator/reaveros

approved_external=$(jq --null-input --compact-output '{
    action: "reopened",
    pull_request: {
        author_association: "NONE",
        draft: false,
        head: {ref: "feature", repo: {full_name: "external/reaveros"}, sha: "ghi"},
        labels: [{name: "ci: aws-approved"}],
        number: 3,
        user: {login: "external"}
    }
}')
run_case approved-external true "${approved_external}"

unapproved_external=$(jq --null-input --compact-output '{
    action: "opened",
    pull_request: {
        author_association: "NONE",
        draft: false,
        head: {ref: "feature", repo: {full_name: "external/reaveros"}, sha: "jkl"},
        labels: [],
        number: 4,
        user: {login: "external"}
    }
}')
run_case unapproved-external false "${unapproved_external}"

missing_fork=$(jq --null-input --compact-output '{
    action: "opened",
    pull_request: {
        author_association: "MEMBER",
        draft: false,
        head: {ref: "feature", repo: null, sha: "missing"},
        labels: [],
        number: 8,
        user: {login: "member"}
    }
}')
run_case missing-fork false "${missing_fork}"

closed_same_repository=$(jq --null-input --compact-output '{
    action: "closed",
    pull_request: {
        author_association: "MEMBER",
        draft: false,
        head: {ref: "feature", repo: {full_name: "reaver-project/reaveros"}, sha: "closed"},
        labels: [],
        number: 7,
        user: {login: "member"}
    }
}')
run_case closed-same-repository false "${closed_same_repository}"

updated_external=$(jq --null-input --compact-output '{
    action: "synchronize",
    pull_request: {
        author_association: "NONE",
        draft: false,
        head: {ref: "feature", repo: {full_name: "external/reaveros"}, sha: "mno"},
        labels: [{name: "ci: aws-approved"}],
        number: 5,
        user: {login: "external"}
    }
}')
run_case updated-external false "${updated_external}"

updated_same_repository=$(jq --null-input --compact-output '{
    action: "synchronize",
    pull_request: {
        author_association: "NONE",
        draft: false,
        head: {ref: "feature", repo: {full_name: "reaver-project/reaveros"}, sha: "pqr"},
        labels: [{name: "ci: aws-approved"}],
        number: 6,
        user: {login: "automation"}
    }
}')
run_case updated-same-repository true "${updated_same_repository}"

run_dispatch_case main true true
run_dispatch_case feature false false

printf 'AWS CI authorization tests passed.\n'
