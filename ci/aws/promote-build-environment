#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 9 ]]
then
    printf '%s\n' \
        "usage: $0 <staging image> <staging unpruned image>" \
        '    <candidate image> <candidate unpruned image>' \
        '    <production image> <production unpruned image>' \
        '    <source tag> <content tag> <publish: true|false>' >&2
    exit 2
fi

if [[ -z ${AWS_REGION:-} ]]
then
    printf 'AWS_REGION must be set.\n' >&2
    exit 1
fi

staging_image=$1
staging_unpruned_image=$2
candidate_image=$3
candidate_unpruned_image=$4
production_image=$5
production_unpruned_image=$6
source_tag=$7
content_tag=$8
publish=$9
production_run_tag=ci-${source_tag}

if [[ ! ${source_tag} =~ ^run-[0-9]+-[0-9]+$ ]]
then
    printf 'Invalid source tag: %s\n' "${source_tag}" >&2
    exit 2
fi
if [[ ! ${content_tag} =~ ^[0-9a-f]{64}$ ]]
then
    printf 'Invalid content tag: %s\n' "${content_tag}" >&2
    exit 2
fi
if [[ ! ${publish} =~ ^(true|false)$ ]]
then
    printf 'Invalid publish setting: %s\n' "${publish}" >&2
    exit 2
fi

verify_image_scan()
{
    repository_uri=$1
    repository_name=${repository_uri#*/}

    if ! aws ecr wait image-scan-complete \
        --region "${AWS_REGION}" \
        --repository-name "${repository_name}" \
        --image-id "imageTag=${source_tag}"
    then
        printf 'Image vulnerability scan did not complete for %s:%s.\n' \
            "${repository_uri}" "${source_tag}" >&2
        return 1
    fi

    if ! scan_report=$(aws ecr describe-image-scan-findings \
        --region "${AWS_REGION}" \
        --repository-name "${repository_name}" \
        --image-id "imageTag=${source_tag}" \
        --output json)
    then
        printf 'Could not read image vulnerability findings for %s:%s.\n' \
            "${repository_uri}" "${source_tag}" >&2
        return 1
    fi

    if ! jq --exit-status \
        '(.imageScanStatus.status == "COMPLETE")
         and (.imageScanFindings.findingSeverityCounts | type == "object")
         and (.imageScanFindings.findings | type == "array")' \
        <<< "${scan_report}" > /dev/null
    then
        printf 'Image scan report is incomplete for %s:%s.\n' \
            "${repository_uri}" "${source_tag}" >&2
        return 1
    fi
    if ! jq --exit-status '
        def severities: ["INFORMATIONAL", "LOW", "MEDIUM", "HIGH", "CRITICAL", "UNDEFINED"];
        .imageScanFindings as $scan
        | (all($scan.findings[]; .severity as $severity | (severities | index($severity)) != null))
          and (all($scan.findingSeverityCounts | to_entries[];
              .key as $severity | (severities | index($severity)) != null
              and (.value | type == "number")))
          and (all(severities[]; . as $severity
              | ($scan.findingSeverityCounts[$severity] // 0)
                == ([$scan.findings[] | select(.severity == $severity)] | length)))
    ' <<< "${scan_report}" > /dev/null
    then
        printf 'Image scan summary and finding list disagree on severity counts.\n' >&2
        return 1
    fi

    critical_findings=$(jq --exit-status --raw-output \
        '.imageScanFindings.findingSeverityCounts.CRITICAL // 0 | numbers' <<< "${scan_report}")
    high_findings=$(jq --exit-status --raw-output \
        '.imageScanFindings.findingSeverityCounts.HIGH // 0 | numbers' <<< "${scan_report}")
    # Debian attributes runtime-kernel CVEs to linux-libc-dev's source package.
    # Image preparation requires linux-libc-dev to be the only binary from it.
    header_only_critical=$(jq '
        [.imageScanFindings.findings[]
         | select(.severity == "CRITICAL")
         | select((.description // "") | startswith("In the Linux kernel"))
         | select([.attributes[]? | select(.key == "package_name") | .value] == ["linux"])
         | select([.attributes[]? | select(.key == "package_version") | .value] as $versions
             | ($versions | length) == 1
               and ($versions[0] | type == "string" and . != ""))]
        | length
    ' <<< "${scan_report}")

    printf 'Image scan for %s:%s found %s critical (%s header-only Linux) and %s high severity vulnerabilities.\n' \
        "${repository_uri}" \
        "${source_tag}" \
        "${critical_findings}" \
        "${header_only_critical}" \
        "${high_findings}"

    if ((critical_findings != header_only_critical))
    then
        printf 'Refusing to promote an image with non-exempt critical vulnerabilities.\n' >&2
        return 1
    fi
    if ((header_only_critical != 0))
    then
        printf '::warning::The build image has %s runtime-kernel findings attributed to linux-libc-dev headers.\n' \
            "${header_only_critical}"
    fi
    if ((high_findings != 0))
    then
        printf '::warning::The promoted build image contains %s high severity vulnerabilities.\n' \
            "${high_findings}"
    fi
}

verify_image_scan "${staging_image}"
verify_image_scan "${staging_unpruned_image}"

auth_directory=$(mktemp -d)
auth_file="${auth_directory}/auth.json"
cleanup()
{
    rm -f "${auth_file}"
    rmdir "${auth_directory}"
}
trap cleanup EXIT
(umask 077; printf '{"auths":{}}\n' > "${auth_file}")

registry=${staging_image%%/*}
aws ecr get-login-password --region "${AWS_REGION}" \
    | skopeo login \
        --authfile "${auth_file}" \
        --username AWS \
        --password-stdin \
        "${registry}"

image_digest()
{
    repository_uri=$1
    tag=$2
    repository_name=${repository_uri#*/}

    aws ecr describe-images \
        --region "${AWS_REGION}" \
        --repository-name "${repository_name}" \
        --image-ids "imageTag=${tag}" \
        --query 'imageDetails[0].imageDigest' \
        --output text 2>/dev/null
}

copy_image()
{
    source=$1
    destination=$2
    destination_tag=$3
    immutable=$4

    if ${immutable}
    then
        source_digest=$(image_digest "${source}" "${source_tag}")
        if destination_digest=$(image_digest "${destination}" "${destination_tag}")
        then
            if [[ ${source_digest} != "${destination_digest}" ]]
            then
                printf 'Immutable image %s:%s already has different content.\n' \
                    "${destination}" "${destination_tag}" >&2
                exit 1
            fi
            return
        fi
    fi

    skopeo copy \
        --all \
        --authfile "${auth_file}" \
        --preserve-digests \
        "docker://${source}:${source_tag}" \
        "docker://${destination}:${destination_tag}"
}

promote_pair()
{
    staging=$1
    candidate=$2
    production=$3

    if ${publish}
    then
        copy_image "${staging}" "${production}" "${content_tag}" true
        copy_image "${staging}" "${production}" "${production_run_tag}" true
        copy_image "${staging}" "${production}" latest false
    else
        copy_image "${staging}" "${candidate}" "${content_tag}" true
    fi
}

promote_pair "${staging_image}" "${candidate_image}" "${production_image}"
promote_pair \
    "${staging_unpruned_image}" \
    "${candidate_unpruned_image}" \
    "${production_unpruned_image}"
