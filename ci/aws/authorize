#!/usr/bin/env bash

set -euo pipefail

if [[ -z ${GITHUB_EVENT_PATH:-} || -z ${GITHUB_OUTPUT:-} ]]
then
    printf 'GITHUB_EVENT_PATH and GITHUB_OUTPUT must be set.\n' >&2
    exit 1
fi

event_name=${GITHUB_EVENT_NAME:-}
source_sha=${GITHUB_SHA:-}
source_ref=${GITHUB_REF_NAME:-}
source_repository=${GITHUB_REPOSITORY:-}
approved=false
automatic_approval=false
publish_cache=false
refresh_cache=false
reason=

case "${event_name}" in
    push)
        approved=true
        publish_cache=true
        reason='push to the protected branch'
        ;;
    schedule)
        approved=true
        publish_cache=true
        refresh_cache=true
        reason='scheduled build-environment refresh'
        ;;
    workflow_dispatch)
        refresh_cache=$(jq --raw-output '.inputs.refresh_build_environment // "false"' "${GITHUB_EVENT_PATH}")
        default_branch=$(jq --exit-status --raw-output '.repository.default_branch' "${GITHUB_EVENT_PATH}")
        if [[ ${source_ref} == "${default_branch}" ]]
        then
            approved=true
            publish_cache=true
            reason='manual workflow dispatch on the default branch'
        else
            reason='manual AWS CI is restricted to the default branch'
        fi
        ;;
    pull_request_target)
        source_sha=$(jq --exit-status --raw-output '.pull_request.head.sha' "${GITHUB_EVENT_PATH}")
        source_ref=$(jq --exit-status --raw-output '.pull_request.head.ref' "${GITHUB_EVENT_PATH}")
        association=$(jq --exit-status --raw-output '.pull_request.author_association' "${GITHUB_EVENT_PATH}")
        author=$(jq --exit-status --raw-output '.pull_request.user.login' "${GITHUB_EVENT_PATH}")
        action=$(jq --exit-status --raw-output '.action' "${GITHUB_EVENT_PATH}")
        draft=$(jq --raw-output '.pull_request.draft' "${GITHUB_EVENT_PATH}")
        head_repository=$(jq --raw-output \
            '.pull_request.head.repo.full_name // ""' \
            "${GITHUB_EVENT_PATH}")
        source_repository=${head_repository}

        if [[ ${action} == closed ]]
        then
            reason='pull request is closed'
        elif [[ ${draft} == true ]]
        then
            reason='pull request is a draft'
        elif [[ ! ${source_repository} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
        then
            reason='pull request head repository is unavailable'
        elif [[ ${head_repository} == "${GITHUB_REPOSITORY}" ]]
        then
            approved=true
            automatic_approval=true
            reason='pull request branch belongs to this repository'
        elif [[ ${association} =~ ^(OWNER|MEMBER|COLLABORATOR)$ ]]
        then
            approved=true
            automatic_approval=true
            reason="trusted GitHub association: ${association}"
        else
            trusted_users=${REAVEROS_AWS_CI_TRUSTED_USERS:-}
            trusted_users=",${trusted_users//[[:space:]]/},"
            if [[ ${trusted_users,,} == *",${author,,},"* ]]
            then
                approved=true
                automatic_approval=true
                reason='author is listed in AWS_CI_TRUSTED_USERS'
            elif jq --exit-status \
                '.pull_request.labels | any(.name == "ci: aws-approved")' \
                "${GITHUB_EVENT_PATH}" >/dev/null
            then
                approved=true
                reason='maintainer approved this pull request revision'
            else
                reason='external pull request revision requires the ci: aws-approved label'
            fi
        fi

        if [[ ${action} == synchronize ]] \
            && jq --exit-status \
                '.pull_request.labels | any(.name == "ci: aws-approved")' \
                "${GITHUB_EVENT_PATH}" >/dev/null
        then
            pull_request_number=$(jq --exit-status --raw-output '.pull_request.number' "${GITHUB_EVENT_PATH}")
            encoded_label=$(jq --null-input --raw-output --arg value 'ci: aws-approved' '$value | @uri')
            gh api \
                --method DELETE \
                "repos/${GITHUB_REPOSITORY}/issues/${pull_request_number}/labels/${encoded_label}" \
                >/dev/null \
                || true
            if ! ${automatic_approval} && [[ ${draft} != true ]]
            then
                approved=false
                reason='new pull request revision requires fresh AWS CI approval'
            fi
        fi
        ;;
    *)
        printf 'Unsupported event: %s\n' "${event_name}" >&2
        exit 1
        ;;
esac

{
    printf 'approved=%s\n' "${approved}"
    printf 'publish_cache=%s\n' "${publish_cache}"
    printf 'refresh_cache=%s\n' "${refresh_cache}"
    printf 'source_ref=%s\n' "${source_ref}"
    printf 'source_repository=%s\n' "${source_repository}"
    printf 'source_sha=%s\n' "${source_sha}"
    printf 'reason=%s\n' "${reason}"
} >> "${GITHUB_OUTPUT}"

printf 'AWS CI authorization: %s (%s)\n' "${approved}" "${reason}"
