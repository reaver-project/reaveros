#!/usr/bin/env bash

set -euo pipefail

if [[ -z ${GITHUB_EVENT_PATH:-} \
    || -z ${GITHUB_OUTPUT:-} \
    || -z ${GITHUB_REPOSITORY:-} ]]
then
    printf 'GITHUB_EVENT_PATH, GITHUB_OUTPUT, and GITHUB_REPOSITORY must be set.\n' >&2
    exit 1
fi

event_name=${GITHUB_EVENT_NAME:-}
source_sha=${GITHUB_SHA:-}
source_ref=${GITHUB_REF_NAME:-}
source_repository=${GITHUB_REPOSITORY}
pull_request_number=
approved=false
publish_cache=false
refresh_cache=false
reason=

case "${event_name}" in
    push)
        default_branch=$(jq --exit-status --raw-output \
            '.repository.default_branch' "${GITHUB_EVENT_PATH}")
        if [[ ${source_ref} == "${default_branch}" ]]
        then
            approved=true
            publish_cache=true
            reason='push to the protected default branch'
        elif [[ ${source_ref} =~ ^pull-request/([1-9][0-9]*)$ ]]
        then
            pull_request_number=${BASH_REMATCH[1]}
            ci_gate_app_slug=${REAVEROS_CI_GATE_APP_SLUG:-}
            expected_actor="${ci_gate_app_slug}[bot]"
            if [[ ! ${ci_gate_app_slug} =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]
            then
                reason='CI Gate App identity is not configured'
            elif [[ ${GITHUB_ACTOR:-} != "${expected_actor}" ]]
            then
                reason='copied CI branch was not updated by the CI Gate App'
            elif [[ ! ${source_sha} =~ ^[0-9a-f]{40}$ ]]
            then
                reason='copied CI branch does not identify a full commit'
            else
                pull_request=$(gh api \
                    "repos/${GITHUB_REPOSITORY}/pulls/${pull_request_number}")
                pull_request_state=$(jq --exit-status --raw-output \
                    '.state' <<< "${pull_request}")
                pull_request_draft=$(jq --raw-output \
                    '.draft' <<< "${pull_request}")
                pull_request_sha=$(jq --exit-status --raw-output \
                    '.head.sha' <<< "${pull_request}")
                pull_request_ref=$(jq --exit-status --raw-output \
                    '.head.ref' <<< "${pull_request}")
                pull_request_repository=$(jq --raw-output \
                    '.head.repo.full_name // ""' <<< "${pull_request}")

                if [[ ${pull_request_state} != open ]]
                then
                    reason='pull request is closed'
                elif [[ ${pull_request_draft} == true ]]
                then
                    reason='pull request is a draft'
                elif [[ ${pull_request_sha} != "${source_sha}" ]]
                then
                    reason='copied CI revision is no longer the current pull request head'
                elif [[ ! ${pull_request_ref} =~ ^[^[:cntrl:]]+$ \
                    || ! ${pull_request_repository} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
                then
                    reason='pull request head repository or branch is unavailable'
                else
                    approved=true
                    source_ref=${pull_request_ref}
                    reason='CI Gate App copied the current pull request revision'
                fi
            fi
        else
            reason='push is outside an AWS CI branch'
        fi
        ;;
    schedule)
        approved=true
        publish_cache=true
        refresh_cache=true
        reason='scheduled build-environment refresh'
        ;;
    workflow_dispatch)
        refresh_cache=$(jq --raw-output \
            '.inputs.refresh_build_environment // "false"' "${GITHUB_EVENT_PATH}")
        default_branch=$(jq --exit-status --raw-output \
            '.repository.default_branch' "${GITHUB_EVENT_PATH}")
        if [[ ${source_ref} == "${default_branch}" ]]
        then
            approved=true
            publish_cache=true
            reason='manual workflow dispatch on the default branch'
        else
            reason='manual AWS CI is restricted to the default branch'
        fi
        ;;
    *)
        printf 'Unsupported event: %s\n' "${event_name}" >&2
        exit 1
        ;;
esac

if [[ ${approved} == true && ${publish_cache} == true ]]; then
    if [[ ! ${source_sha} =~ ^[0-9a-f]{40}$ ]] ||
        [[ $(gh api "repos/${GITHUB_REPOSITORY}/commits/${source_sha}" \
            --jq '.commit.verification.verified') != true ]]; then
        approved=false
        publish_cache=false
        refresh_cache=false
        reason='default branch commit is not signature-verified'
    fi
fi

{
    printf 'approved=%s\n' "${approved}"
    printf 'publish_cache=%s\n' "${publish_cache}"
    printf 'pull_request_number=%s\n' "${pull_request_number}"
    printf 'refresh_cache=%s\n' "${refresh_cache}"
    printf 'source_ref=%s\n' "${source_ref}"
    printf 'source_repository=%s\n' "${source_repository}"
    printf 'source_sha=%s\n' "${source_sha}"
    printf 'reason=%s\n' "${reason}"
} >> "${GITHUB_OUTPUT}"

printf 'AWS CI authorization: %s (%s)\n' "${approved}" "${reason}"
