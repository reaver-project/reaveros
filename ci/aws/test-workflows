#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
infrastructure_contract_version=$(<"${self_dir}/infrastructure-contract-version")
infrastructure_revision=$(<"${self_dir}/infrastructure-revision")
if [[ ! ${infrastructure_contract_version} =~ ^[0-9]+$ \
    || ! ${infrastructure_revision} =~ ^[0-9a-f]{40}$ ]]
then
    printf 'Invalid recorded infrastructure contract or revision.\n' >&2
    exit 1
fi
mapfile -t workflow_files < <(
    find "${repo_root}/.github/workflows" \
        -maxdepth 1 \
        -type f \
        -name '*.yml' \
        -print \
        | sort
)

for workflow in "${workflow_files[@]}"
do
    while IFS= read -r reference
    do
        if [[ ${reference} == ./* ]]
        then
            continue
        fi
        revision=${reference##*@}
        if [[ ! ${revision} =~ ^[0-9a-f]{40}$ ]]
        then
            printf '%s contains an action that is not pinned by full SHA: %s\n' \
                "${workflow}" "${reference}" >&2
            exit 1
        fi
    done < <(
        sed -nE 's/^[[:space:]]*uses:[[:space:]]*([^[:space:]#]+).*/\1/p' \
            "${workflow}"
    )
done

mapfile -t infrastructure_references < <(
    sed -nE \
        's/^[[:space:]]*uses:[[:space:]]*(reaver-project\/infrastructure\/actions\/[^[:space:]#]+).*/\1/p' \
        "${workflow_files[@]}"
)
if [[ ${#infrastructure_references[@]} -ne 4 ]]
then
    printf 'Expected four shared infrastructure action uses, found %s.\n' \
        "${#infrastructure_references[@]}" >&2
    exit 1
fi
for reference in "${infrastructure_references[@]}"
do
    if [[ ${reference##*@} != "${infrastructure_revision}" ]]
    then
        printf 'Shared infrastructure action has the wrong revision: %s\n' \
            "${reference}" >&2
        exit 1
    fi
done

for contract_consumer in \
    "${repo_root}/.github/workflows/aws-build-environment-selection.yml" \
    "${repo_root}/.github/workflows/aws-cache-promotion.yml"
do
    if ! grep --fixed-strings --quiet \
        "expected-contract-version: '${infrastructure_contract_version}'" \
        "${contract_consumer}"
    then
        printf '%s does not require infrastructure contract version %s.\n' \
            "${contract_consumer}" \
            "${infrastructure_contract_version}" >&2
        exit 1
    fi
done

if grep --fixed-strings --quiet 'packages: write' "${workflow_files[@]}" \
    || [[ -e ${repo_root}/.github/workflows/aws-publish-build-environment.yml ]]
then
    printf 'ReaverOS workflows must not publish packages directly.\n' >&2
    exit 1
fi

promotion_workflow="${repo_root}/.github/workflows/aws-cache-promotion.yml"
for promotion_invariant in \
    'PRODUCTION_ROLE_ARN: ${{ vars.AWS_PRODUCTION_PROMOTION_ROLE_ARN }}' \
    "PUBLISH_PRODUCTION: \${{ inputs.publish_cache && github.event_name != 'pull_request_target' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}" \
    'role-arn: ${{ steps.role.outputs.role_arn }}' \
    'PUBLISH_CACHE: ${{ steps.role.outputs.publish_production }}'; do
    if ! grep --fixed-strings --quiet \
        "${promotion_invariant}" "${promotion_workflow}"
    then
        printf 'Production promotion role selection is missing: %s\n' \
            "${promotion_invariant}" >&2
        exit 1
    fi
done

if grep --extended-regexp --quiet \
    'uses:[[:space:]]+[^.][^[:space:]]*reaveros/.github/workflows/' \
    "${workflow_files[@]}"
then
    printf 'A same-repository reusable workflow uses a mutable remote reference.\n' >&2
    exit 1
fi

obsolete_paths=(
    ci/aws/deploy-infrastructure
    ci/aws/launch-runner
    ci/aws/plan-infrastructure
    ci/aws/terminate-runner
    ci/aws/test-infrastructure
    infra
)
for obsolete_path in "${obsolete_paths[@]}"
do
    if [[ -e ${repo_root}/${obsolete_path} ]]
    then
        printf 'Retired infrastructure helper still exists: %s\n' \
            "${obsolete_path}" >&2
        exit 1
    fi
done

if grep --extended-regexp --quiet \
    'RunnerAppSecret|runner[_-]app[_-]secret|secretsmanager' \
    "${workflow_files[@]}"
then
    printf 'A ReaverOS workflow attempts to read runner-manager credentials.\n' >&2
    exit 1
fi

ci_workflow="${repo_root}/.github/workflows/ci.yml"
if grep --fixed-strings --quiet 'pull_request_target:' "${ci_workflow}"
then
    printf 'AWS-backed CI still executes from pull_request_target.\n' >&2
    exit 1
fi
# GitHub expression syntax is intentionally literal in these invariants.
# shellcheck disable=SC2016
for copied_ci_invariant in \
    '- pull-request/*' \
    'REAVEROS_CI_GATE_APP_SLUG: ${{ vars.CI_GATE_APP_SLUG }}' \
    'pull_request_number: ${{ steps.authorize.outputs.pull_request_number }}'; do
    if ! grep --fixed-strings --quiet -- \
        "${copied_ci_invariant}" "${ci_workflow}"
    then
        printf 'Copied-revision CI invariant is missing: %s\n' \
            "${copied_ci_invariant}" >&2
        exit 1
    fi
done
if grep --extended-regexp --quiet \
    'AWS_CI_TRUSTED_USERS|ci: aws-approved' \
    "${ci_workflow}" "${self_dir}/authorize"
then
    printf 'Legacy actor or label based AWS approval remains enabled.\n' >&2
    exit 1
fi

# GitHub expression syntax is intentionally literal in these invariants.
# shellcheck disable=SC2016
if [[ $(grep --fixed-strings --count \
    'cache_tag: ${{ needs.select-build-environment.outputs.cache_tag }}' \
    "${ci_workflow}") -ne 4 ]] \
    || ! grep --fixed-strings --quiet \
        'cache_tag: run-${{ github.run_id }}-${{ github.run_attempt }}' "${ci_workflow}" \
    || ! grep --fixed-strings --quiet \
        'source_tag: ${{ needs.select-build-environment.outputs.cache_tag }}' \
        "${ci_workflow}"
then
    printf 'Rerun jobs must use the tag produced by successful preparation.\n' >&2
    exit 1
fi

require_ci_condition()
{
    job=$1
    shift
    condition=$(awk -v job="${job}" '
        $0 == "    " job ":" { in_job = 1; next }
        in_job && /^    [a-z][a-z-]*:/ { exit }
        in_job && /^        if:/ { print; exit }
    ' "${ci_workflow}")
    for fragment in "$@"
    do
        if [[ ${condition} != *"${fragment}"* ]]
        then
            printf 'CI job %s is missing condition %s.\n' "${job}" "${fragment}" >&2
            exit 1
        fi
    done
}

for validation_job in dispatch-standalone dispatch-producers
do
    require_ci_condition "${validation_job}" \
        '!cancelled()' \
        "needs.authorize.outputs.approved == 'true'" \
        "needs.select-build-environment.result == 'success'" \
        "needs.select-build-environment.outputs.mode == 'reuse'" \
        "needs.build-environment.outputs.ready == 'true'"
done
require_ci_condition dispatch-consumers \
    '!cancelled()' \
    "needs.select-build-environment.result == 'success'" \
    "needs.build-environment.outputs.ready == 'true'" \
    "needs.dispatch-producers.result == 'success'"
require_ci_condition promote-build-environment \
    '!cancelled()' \
    "needs.build-matrix.result == 'success'" \
    "needs.select-build-environment.result == 'success'" \
    "needs.build-environment.outputs.ready == 'true'" \
    "needs.build-matrix.outputs.has_standalone != 'true' || needs.dispatch-standalone.result == 'success'" \
    "needs.build-matrix.outputs.has_producer != 'true' || needs.dispatch-producers.result == 'success'" \
    "needs.build-matrix.outputs.has_consumer != 'true' || needs.dispatch-consumers.result == 'success'"

for matrix_invariant in \
    'python3 -m unittest discover -s ci/matrix' \
    './ci/aws/test-run-matrix-job' \
    './ci/aws/test-workflows' \
    'python3 ci/matrix/compile.py ci/matrix.yaml --workflow ci' \
    'matrix: ${{ fromJSON(needs.build-matrix.outputs.standalone) }}' \
    'matrix: ${{ fromJSON(needs.build-matrix.outputs.producer) }}' \
    'matrix: ${{ fromJSON(needs.build-matrix.outputs.consumer) }}' \
    'job_matrix: ${{ toJSON(matrix.job_matrix) }}'
do
    if ! grep --fixed-strings --quiet "${matrix_invariant}" "${ci_workflow}"
    then
        printf 'The compiled CI matrix is not consumed: %s\n' \
            "${matrix_invariant}" >&2
        exit 1
    fi
done

for reusable_workflow in \
    "${repo_root}/.github/workflows/aws-runner.yml" \
    "${repo_root}/.github/workflows/aws-build-environment-selection.yml" \
    "${repo_root}/.github/workflows/aws-cache-promotion.yml"
do
    if grep --extended-regexp --quiet \
        'inputs\.source_(sha|repository)' "${reusable_workflow}" \
        || ! grep --fixed-strings --quiet \
            'repository: ${{ github.repository }}' "${reusable_workflow}" \
        || ! grep --fixed-strings --quiet \
            'ref: ${{ github.sha }}' "${reusable_workflow}"
    then
        printf '%s must check out the caller commit, not a caller-supplied revision.\n' \
            "${reusable_workflow}" >&2
        exit 1
    fi
done

runner_workflow="${repo_root}/.github/workflows/aws-runner.yml"
for compiler_cache_invariant in \
    "uses: reaver-project/infrastructure/actions/compiler-cache@${infrastructure_revision}" \
    "SCCACHE_SKIP_CACHE_CHECK: 'true'" \
    'group: reaveros' \
    'matrix: ${{ fromJSON(inputs.job_matrix) }}' \
    'reaveros-class-${{ inputs.task ==' \
    'reaveros-${{ github.run_id }}-${{ github.run_attempt }}-${{ inputs.task ==' \
    'run: ./ci/aws/run-matrix-job' \
    'project-slug: reaveros'; do
    if ! grep --fixed-strings --quiet \
        "${compiler_cache_invariant}" "${runner_workflow}"; then
        printf 'Compiler-cache runner policy is missing: %s\n' \
            "${compiler_cache_invariant}" >&2
        exit 1
    fi
done
if grep --extended-regexp --quiet \
    'needs\.provision|id-token: write|ephemeral-runner@|^    (provision|cleanup):' \
    "${runner_workflow}" \
    || ! grep --fixed-strings --quiet \
        'repository_names=$(./ci/aws/strip-ecr-registry "${AWS_REGION}"' \
        "${runner_workflow}" \
    || ! grep --fixed-strings --quiet \
        'aws cloudformation describe-stacks' \
        "${runner_workflow}"
then
    printf 'Runner lifecycle or ECR output isolation regressed.\n' >&2
    exit 1
fi
if [[ $(grep --fixed-strings --count \
    'runner_size: ${{ needs.select-build-environment.outputs.runner_size }}' \
    "${ci_workflow}") -ne 1 ]]
then
    printf 'The selected preparation runner class is not used.\n' >&2
    exit 1
fi

selector_workflow="${repo_root}/.github/workflows/aws-build-environment-selection.yml"
for selection_invariant in \
    'run: ./ci/aws/select-build-environment' \
    'id-token: write' \
    'role-arn: ${{ vars.AWS_RUNNER_ROLE_ARN }}'
do
    if ! grep --fixed-strings --quiet "${selection_invariant}" "${selector_workflow}"
    then
        printf 'The hosted selector is missing %s.\n' "${selection_invariant}" >&2
        exit 1
    fi
done
if ! grep --fixed-strings --quiet \
    '"${self_dir}/free-hosted-runner-space"' \
    "${repo_root}/ci/aws/select-build-environment"
then
    printf 'The hosted selector does not free space before pulling a seed.\n' >&2
    exit 1
fi

printf 'AWS CI workflow policy tests passed.\n'
