#!/usr/bin/env bash

set -euo pipefail

if [[ $(basename -- "$0") == docker ]]
then
    printf '%s\n' "$@" > "${BUILD_IMAGE_TEST_LOG}"
    exit
fi

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
test_directory=$(mktemp -d)
artifact_directory=.ci-build-image-test-${$}
mkdir "${test_directory}/bin"

cleanup()
{
    rm -rf "${test_directory}" "${repo_root}/${artifact_directory}"
}
trap cleanup EXIT

ln -s "${self_dir}/test-build-image" "${test_directory}/bin/docker"
export BUILD_IMAGE_TEST_LOG="${test_directory}/docker-arguments"
export PATH="${test_directory}/bin:${PATH}"

cd "${repo_root}"
"${self_dir}/build-image" \
    amd64 uefi efipart \
    example.invalid/reaveros-build-env:test \
    "${artifact_directory}"

if ! grep --fixed-strings --line-regexp --quiet \
    "${repo_root}/${artifact_directory}:/artifacts" \
    "${BUILD_IMAGE_TEST_LOG}"
then
    printf 'The image artifact directory was not mounted by absolute path.\n' >&2
    exit 1
fi

for required_argument in \
    '-DREAVEROS_ARCHITECTURES="${architecture}"' \
    '-DREAVEROS_LOADERS="${loader}"' \
    '-DCMAKE_BUILD_TYPE="${configuration}"'
do
    if ! grep --fixed-strings --quiet -- "${required_argument}" "${BUILD_IMAGE_TEST_LOG}"
    then
        printf 'The image build did not configure %s.\n' "${required_argument}" >&2
        exit 1
    fi
done

for configuration in Debug Release
do
    "${self_dir}/build-image" amd64 uefi efipart \
        example.invalid/reaveros-build-env:test "${artifact_directory}" "${configuration}"
    if [[ $(tail -n1 "${BUILD_IMAGE_TEST_LOG}") != "${configuration}" ]]
    then
        printf 'The image build did not forward the %s configuration.\n' "${configuration}" >&2
        exit 1
    fi
done

"${repo_root}/docker/test-build-image"
"${repo_root}/docker/test-prune-image"
"${repo_root}/docker/test-update-images"
"${repo_root}/ci/aws/test-push-images"
"${repo_root}/docker/test-verify-build-environment-packages"
"${repo_root}/docker/test-compiler-cache-options"
"${repo_root}/ci/test-cache-launcher"
"${self_dir}/test-build-selection"
"${self_dir}/test-component-registration"
"${self_dir}/test-native-tests"
"${self_dir}/test-lifecycle-guard"
"${self_dir}/test-toolchain-lifecycle"
"${self_dir}/test-helper-contracts"
"${self_dir}/test-host-tools"
"${self_dir}/test-images"
"${self_dir}/test-component-install"
"${self_dir}/test-install-transfer"
"${self_dir}/test-build-dependencies"
"${self_dir}/test-llvm-builtins"
"${self_dir}/test-incbin-generation"
"${repo_root}/ci/aws/test-strip-ecr-registry"
"${self_dir}/test-toolchain-git-tag"
"${self_dir}/test-toolchain-failure-recovery"
"${self_dir}/test-toolchain-helper-inputs"
"${self_dir}/test-toolchain-git-archive"
cmake -DTEST_DIRECTORY="${test_directory}/patch-dependencies" \
    -P "${self_dir}/test-toolchain-patch-dependencies.cmake"

prune_build_directory="${test_directory}/prune-stamps"
cmake -S "${repo_root}" -B "${prune_build_directory}" -DREAVEROS_ENABLE_UNIT_TESTS=ON >/dev/null
llvm_stamp_directory="${prune_build_directory}/toolchain/toolchain-llvm-prefix/src/toolchain-llvm-stamp"
touch "${llvm_stamp_directory}/toolchain-llvm-mkdir"
touch "${llvm_stamp_directory}/toolchain-llvm-download"
if cmake --build "${prune_build_directory}" --target toolchain-cmake-prune \
    > "${test_directory}/incomplete-prune.log" 2>&1
then
    printf 'An incomplete toolchain installation was pruned.\n' >&2
    exit 1
fi
if ! grep --fixed-strings --quiet 'refusing to prune incomplete' "${test_directory}/incomplete-prune.log"
then
    cat "${test_directory}/incomplete-prune.log" >&2
    exit 1
fi
python3 "${self_dir}/fixtures/toolchain-lifecycle/seed-completed-cache.py" "${prune_build_directory}"
cmake --build "${prune_build_directory}" \
    --target toolchain-cmake-prune toolchain-dosfstools-prune \
        toolchain-mtools-prune toolchain-llvm-prune >/dev/null
cmake -S "${repo_root}" -B "${prune_build_directory}" -DREAVEROS_ENABLE_UNIT_TESTS=ON >/dev/null
if [[ ! -f ${llvm_stamp_directory}/toolchain-llvm-download \
    || ${llvm_stamp_directory}/toolchain-llvm-download -ot ${llvm_stamp_directory}/toolchain-llvm-mkdir \
    || ${llvm_stamp_directory}/toolchain-llvm-download -ot ${llvm_stamp_directory}/download-toolchain-llvm.cmake \
    || ${llvm_stamp_directory}/toolchain-llvm-download -ot ${llvm_stamp_directory}/toolchain-llvm-urlinfo.txt ]]
then
    printf 'Pruning made LLVM download run again in the validation image.\n' >&2
    exit 1
fi
for project in toolchain-cmake toolchain-dosfstools toolchain-mtools toolchain-llvm
do
    stamp_directory="${prune_build_directory}/toolchain/${project}-prefix/src/${project}-stamp"
    source_step=set-to-tag
    if [[ ${project} == toolchain-llvm ]]
    then
        source_step=hydrate-source
    fi
    if [[ ! -f ${stamp_directory}/${project}-apply-patches \
        || ${stamp_directory}/${project}-apply-patches -ot ${stamp_directory}/${project}-${source_step} \
        || ${stamp_directory}/${project}-apply-patches -ot ${prune_build_directory}/toolchain/${project}-patch-inputs ]]
    then
        printf 'Pruning left the %s patch step out of date.\n' "${project}" >&2
        exit 1
    fi
    if [[ ! -f ${stamp_directory}/${project}-update_disconnected \
        || ! -f ${stamp_directory}/${project}-patch_disconnected \
        || ${stamp_directory}/${project}-patch_disconnected -ot ${stamp_directory}/${project}-update_disconnected ]]
    then
        printf 'Pruning left the %s disconnected source steps out of date.\n' "${project}" >&2
        exit 1
    fi
    if [[ ${project} == toolchain-llvm ]]
    then
        # Hydration depends on the connected update/patch steps; Git tag
        # selection instead precedes the disconnected update/patch chain.
        if [[ ! -f ${stamp_directory}/${project}-update \
            || ! -f ${stamp_directory}/${project}-patch \
            || ${stamp_directory}/${project}-${source_step} -ot ${stamp_directory}/${project}-update \
            || ${stamp_directory}/${project}-${source_step} -ot ${stamp_directory}/${project}-patch ]]
        then
            printf 'Pruning left LLVM hydration older than its source prerequisites.\n' >&2
            exit 1
        fi
    elif [[ ${stamp_directory}/${project}-update_disconnected -ot ${stamp_directory}/${project}-${source_step} ]]
    then
        printf 'Pruning left the %s disconnected update step older than tag selection.\n' "${project}" >&2
        exit 1
    fi
    if [[ ! -f ${stamp_directory}/${project}-invalidate-build \
        || ${stamp_directory}/${project}-invalidate-build -ot \
            ${prune_build_directory}/toolchain/${project}-source-inputs ]]
    then
        printf 'Pruning left the %s source identity step out of date.\n' "${project}" >&2
        exit 1
    fi
    if ! grep --fixed-strings --quiet 'toolchain/invalidate-stale-build' \
        "${prune_build_directory}/toolchain/CMakeFiles/${project}-install.dir/build.make"
    then
        printf 'The %s build omits source identity validation.\n' "${project}" >&2
        exit 1
    fi
done

invalidator="${repo_root}/toolchain/invalidate-stale-build"
for project in toolchain-cmake toolchain-dosfstools toolchain-mtools toolchain-llvm
do
    binary_directory="${prune_build_directory}/toolchain/${project}-prefix/src/${project}-build"
    install_directory="${prune_build_directory}/install/toolchain/${project#toolchain-}"
    identity_file="${prune_build_directory}/toolchain/${project}-source-identity"
    identity=$(<"${prune_build_directory}/toolchain/${project}-source-inputs")
    bash "${invalidator}" "${prune_build_directory}" "${project}" \
        "${binary_directory}" "${install_directory}" "${identity}"
    if [[ $(<"${identity_file}") != "${identity}" ]]
    then
        printf 'The %s source identity was not recorded.\n' "${project}" >&2
        exit 1
    fi
    mkdir -p "${binary_directory}"
    touch "${binary_directory}/preserve-on-same-source"
    touch "${install_directory}/preserve-on-same-source"
done
cmake -S "${repo_root}" -B "${prune_build_directory}" -DREAVEROS_ENABLE_UNIT_TESTS=ON >/dev/null
for project in toolchain-cmake toolchain-dosfstools toolchain-mtools toolchain-llvm
do
    binary_directory="${prune_build_directory}/toolchain/${project}-prefix/src/${project}-build"
    install_directory="${prune_build_directory}/install/toolchain/${project#toolchain-}"
    identity_file="${prune_build_directory}/toolchain/${project}-source-identity"
    identity=$(<"${prune_build_directory}/toolchain/${project}-source-inputs")
    if [[ ! -f ${binary_directory}/preserve-on-same-source \
        || ! -f ${install_directory}/preserve-on-same-source ]]
    then
        printf 'Configuring a probe discarded the cached %s build.\n' "${project}" >&2
        exit 1
    fi
    bash "${invalidator}" "${prune_build_directory}" "${project}" \
        "${binary_directory}" "${install_directory}" "${identity}"
    if [[ ! -f ${binary_directory}/preserve-on-same-source \
        || ! -f ${install_directory}/preserve-on-same-source ]]
    then
        printf 'An unchanged %s source discarded its binary directory.\n' "${project}" >&2
        exit 1
    fi
    printf 'old source identity\n' > "${identity_file}"
    bash "${invalidator}" "${prune_build_directory}" "${project}" \
        "${binary_directory}" "${install_directory}" "${identity}"
    if [[ -e ${binary_directory}/preserve-on-same-source \
        || ! -d ${binary_directory} \
        || -e ${install_directory}/preserve-on-same-source \
        || ! -d ${install_directory} ]]
    then
        printf 'A changed %s source retained stale outputs or removed its directories.\n' \
            "${project}" >&2
        exit 1
    fi
    rmdir "${binary_directory}"
    rmdir "${install_directory}"
    bash "${invalidator}" "${prune_build_directory}" "${project}" \
        "${binary_directory}" "${install_directory}" "${identity}"
    if [[ ! -d ${binary_directory} || ! -d ${install_directory} ]]
    then
        printf 'An unchanged %s source did not restore its build directories.\n' \
            "${project}" >&2
        exit 1
    fi
done
if bash "${invalidator}" "${prune_build_directory}" toolchain-llvm \
    "${prune_build_directory}" "${install_directory}" "${identity}" >/dev/null 2>&1
then
    printf 'The toolchain build invalidator accepted a broad target.\n' >&2
    exit 1
fi
if bash "${invalidator}" "${prune_build_directory}" toolchain-llvm \
    "${binary_directory}" "${prune_build_directory}" "${identity}" >/dev/null 2>&1
then
    printf 'The toolchain build invalidator accepted a broad install target.\n' >&2
    exit 1
fi

printf 'CI image-build tests passed.\n'
