#!/usr/bin/env python3

import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


repository = Path(__file__).resolve().parent.parent


def run(*command):
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    assert result.returncode == 0, result.stdout
    assert "jobserver unavailable" not in result.stdout, result.stdout
    return result.stdout


with tempfile.TemporaryDirectory(prefix="toolchain scheduling with spaces ") as temporary:
    root = Path(temporary)
    command = ["cmake", "-S", str(repository), "-B", str(root), "-G", "Unix Makefiles",
        "-DREAVEROS_USE_CACHE=OFF", "-DREAVEROS_ENABLE_UNIT_TESTS=ON"]
    run(*command)
    descriptors = sorted((root / "toolchain").glob("*-lifecycle.json"))
    before = {path: json.loads(path.read_text())["identity"] for path in descriptors}
    run(sys.executable, str(repository / "ci/fixtures/toolchain-lifecycle/seed-completed-cache.py"), str(root))
    run("make", "-C", str(root), "-j4", "all-toolchain-prune")
    outputs = [Path(json.loads(path.read_text())["directories"]["install"]) / output
        for path in descriptors for output in json.loads(path.read_text())["required_outputs"]]
    timestamps = {path: path.stat().st_mtime_ns for path in outputs}
    launcher = shutil.which("env")  # Forward the unchanged compiler command.
    for selected in (launcher, launcher + ";LAUNCH_ENV=left|right __reaveros_list_separator__"):
        run(*command, "-DCMAKE_C_COMPILER_LAUNCHER=" + selected, "-DCMAKE_CXX_COMPILER_LAUNCHER=" + selected)
        assert {path: json.loads(path.read_text())["identity"] for path in descriptors} == before
        output = run("make", "-C", str(root), "-j4", "toolchain-dosfstools-install", "toolchain-mtools-install")
        assert "Performing " not in output and "recovering" not in output, output
        assert all(path.stat().st_mtime_ns == timestamp for path, timestamp in timestamps.items())
    for project in ("dosfstools", "mtools"):
        state = json.loads((root / "toolchain" / ("toolchain-" + project + "-installed-state.json")).read_text())
        assert state["pruned"]
        prefix = root / "toolchain" / ("toolchain-" + project + "-prefix/src")
        assert not any((prefix / ("toolchain-" + project)).iterdir())
        assert not any((prefix / ("toolchain-" + project + "-build")).iterdir())

    # Ignoring launchers must not ignore a changed compiler selection.
    compiler = root / "selected compiler"
    compiler.symlink_to(shutil.which("cc"))
    run(*command, "-DCMAKE_C_COMPILER=" + str(compiler))
    for project in ("dosfstools", "mtools"):
        descriptor = root / "toolchain" / ("toolchain-" + project + "-lifecycle.json")
        assert json.loads(descriptor.read_text())["identity"] != before[descriptor]
        output = run(sys.executable, str(repository / "toolchain/installed-state"), "check", str(descriptor))
        assert "recovering changed installed inputs" in output, output
        assert not (root / "toolchain" / ("toolchain-" + project + "-installed-state.json")).exists()

print("Launcher changes retain pruned filesystem tools; compiler changes still invalidate them.")
