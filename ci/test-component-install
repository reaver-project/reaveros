#!/usr/bin/env python3

import os
from pathlib import Path
import shutil
import subprocess
import tempfile


repository = Path(__file__).resolve().parent.parent
fixture = repository / "ci/fixtures/component-install"


def run(*command, succeeds=True):
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if (result.returncode == 0) != succeeds:
        raise RuntimeError(result.stdout)
    if "jobserver unavailable" in result.stdout:
        raise AssertionError(result.stdout)
    return result.stdout


with tempfile.TemporaryDirectory() as temporary:
    directory = Path(temporary)
    source = directory / "source with spaces"
    shutil.copytree(fixture, source)
    for name in ("alpha", "beta"):
        component = source / name
        shutil.copytree(fixture / "component", component)
        (component / "files").mkdir()
        (component / "files" / (name + " header.h")).write_text(name + " header\n")
        (component / "hosted.h").write_text(name + " hosted header\n")
    build = directory / "build with spaces"
    run("cmake", "-S", str(source), "-B", str(build), "-G", "Unix Makefiles",
        "-DTEST_REPOSITORY=" + str(repository))

    def build_components(target="components", succeeds=True):
        return run("make", "-C", str(build), "-j4", target, succeeds=succeeds)

    sysroot = build / "install/sysroots/amd64-freestanding"
    hosted = build / "install/sysroots/amd64-hosted"
    ownership = build / "cmake/install-ownership"
    alpha_owner = ownership / "alpha-freestanding-amd64.txt"
    beta_owner = ownership / "beta-freestanding-amd64.txt"
    alpha_binary = build / "alpha-freestanding-amd64-prefix/src/alpha-freestanding-amd64-build"
    alpha_manifest = alpha_binary / "install_manifest.txt"

    build_components()
    alpha_header = sysroot / "usr/include/alpha header.h"
    beta_header = sysroot / "usr/include/beta header.h"
    assert alpha_header.read_text() == "alpha header\n"
    assert beta_header.read_text() == "beta header\n"
    for name in ("alpha", "beta"):
        executable = sysroot / "usr/bin" / name
        assert os.access(executable, os.X_OK)
        run(str(executable))
        link = sysroot / "usr/lib" / ("lib" + name + "-library.so")
        assert link.is_symlink() and link.resolve().is_file()
        assert (hosted / "usr/include" / name / "hosted.h").is_file()
    assert str(hosted / "usr/include/alpha/hosted.h") in alpha_owner.read_text()

    # The catalogs support the cold reset performed by dependency CI.
    project = "alpha-freestanding-amd64"
    catalog_root = build / "cmake"
    directories = [Path(line) for line in (
        catalog_root / "component-build-directories" / (project + ".txt")
    ).read_text().splitlines()]
    assert len(directories) == 3
    assert directories[0] == alpha_binary
    manifest_record = catalog_root / "install-projects" / (project + ".txt")
    assert manifest_record.read_text().splitlines() == [str(alpha_manifest)]
    toolchain_file = build / "install/toolchain/files/amd64-freestanding.cmake"
    toolchain_mtime = toolchain_file.stat().st_mtime_ns
    beta_mtime = beta_header.stat().st_mtime_ns
    for child_directory in directories:
        assert child_directory.is_relative_to(build)
        shutil.rmtree(child_directory)
    run("cmake", "-S", str(source), "-B", str(build), "-G", "Unix Makefiles",
        "-DTEST_REPOSITORY=" + str(repository))
    build_components(project)
    assert alpha_manifest.is_file()
    assert os.access(sysroot / "usr/bin/alpha", os.X_OK)
    assert beta_header.stat().st_mtime_ns == beta_mtime
    assert toolchain_file.stat().st_mtime_ns == toolchain_mtime

    # An unchanged install keeps artifact timestamps and symlinks intact.
    installed = [path for path in sysroot.rglob("*") if path.is_file()]
    timestamps = {path: path.lstat().st_mtime_ns for path in installed}
    build_components()
    assert all(path.lstat().st_mtime_ns == mtime for path, mtime in timestamps.items())

    # Rename a header and shared-library version, preserving the neighboring project.
    renamed_source = source / "alpha/files/renamed header.h"
    (source / "alpha/files/alpha header.h").rename(renamed_source)
    alpha_cmake = source / "alpha/CMakeLists.txt"
    alpha_cmake.write_text(alpha_cmake.read_text().replace("VERSION 1.2", "VERSION 1.3"))
    build_components("alpha-freestanding-amd64")
    renamed_header = sysroot / "usr/include/renamed header.h"
    assert not alpha_header.exists() and renamed_header.is_file()
    assert not (sysroot / "usr/lib/libalpha-library.so.1.2").exists()
    assert (sysroot / "usr/lib/libalpha-library.so").resolve().name == "libalpha-library.so.1.3"
    assert beta_header.read_text() == "beta header\n"

    # A failing installation cannot publish staged changes or lose old ownership.
    previous_ownership = alpha_owner.read_bytes()
    previous_manifest = alpha_manifest.read_bytes()
    renamed_source.write_text("changed header\n")
    (source / "alpha/hosted.h").write_text("changed hosted header\n")
    (source / "alpha/fail-install").touch()
    output = build_components("alpha-freestanding-amd64", succeeds=False)
    assert "Intentional install failure" in output
    assert renamed_header.read_text() == "alpha header\n"
    assert (hosted / "usr/include/alpha/hosted.h").read_text() == "alpha hosted header\n"
    assert alpha_owner.read_bytes() == previous_ownership
    assert alpha_manifest.read_bytes() == previous_manifest
    (source / "alpha/fail-install").unlink()
    build_components("alpha-freestanding-amd64")
    assert renamed_header.read_text() == "changed header\n"

    # Equal contents are still an ownership conflict. No existing file is overwritten.
    conflict = source / "beta/files/renamed header.h"
    conflict.write_text(renamed_source.read_text())
    previous_beta = beta_owner.read_bytes()
    output = build_components("beta-freestanding-amd64", succeeds=False)
    for diagnostic in ("Install ownership conflict", "alpha-freestanding-amd64",
                       "beta-freestanding-amd64", "renamed header.h"):
        assert diagnostic in output, output
    assert beta_owner.read_bytes() == previous_beta
    assert renamed_header.read_text() == "changed header\n"
    conflict.write_text("conflicting replacement\n")
    build_components("beta-freestanding-amd64", succeeds=False)
    assert renamed_header.read_text() == "changed header\n"
    conflict.unlink()
    build_components("beta-freestanding-amd64")

    # Cross-sysroot claims use the same ownership rules.
    beta_cmake = source / "beta/CMakeLists.txt"
    beta_original = beta_cmake.read_text()
    beta_cmake.write_text(beta_original + '\ninstall(FILES hosted.h DESTINATION '
        '"${CMAKE_INSTALL_PREFIX}/../amd64-hosted/usr/include/alpha")\n')
    output = build_components("beta-freestanding-amd64", succeeds=False)
    assert "Install ownership conflict" in output and "amd64-hosted" in output, output
    assert (hosted / "usr/include/alpha/hosted.h").read_text() == "changed hosted header\n"
    beta_cmake.write_text(beta_original)
    build_components("beta-freestanding-amd64")

    # Ownership persists when the child manifest disappears.
    alpha_manifest.unlink()
    renamed_source.unlink()
    build_components("alpha-freestanding-amd64")
    assert not renamed_header.exists() and beta_header.is_file()

    # Adopt old per-child manifests when upgrading an existing build.
    shutil.rmtree(ownership)
    (source / "beta/files/beta header.h").rename(source / "beta/files/new beta.h")
    build_components("beta-freestanding-amd64")
    assert not beta_header.exists() and (sysroot / "usr/include/new beta.h").is_file()
    assert (hosted / "usr/include/alpha/hosted.h").is_file()

    # Two parallel projects claiming a new path must not both publish it.
    for name in ("alpha", "beta"):
        (source / name / "files/shared.h").write_text(name + " shared\n")
    output = build_components(succeeds=False)
    assert "Install ownership conflict" in output, output
    shared = sysroot / "usr/include/shared.h"
    winner = shared.read_text().split()[0]
    winner_owner = ownership / (winner + "-freestanding-amd64.txt")
    loser = "beta" if winner == "alpha" else "alpha"
    loser_owner = ownership / (loser + "-freestanding-amd64.txt")
    assert str(shared) in winner_owner.read_text()
    assert not loser_owner.exists() or str(shared) not in loser_owner.read_text()
    (source / loser / "files/shared.h").unlink()
    build_components()

    # An empty install retires all of that project's files and keeps its neighbor.
    alpha_cmake.write_text('cmake_minimum_required(VERSION 3.31)\n'
        'project(alpha NONE)\ninstall(FILES)\n')
    build_components("alpha-freestanding-amd64")
    assert not (sysroot / "usr/bin/alpha").exists()
    assert not (sysroot / "usr/lib/libalpha-library.so").is_symlink()
    assert not (hosted / "usr/include/alpha/hosted.h").exists()
    assert alpha_owner.read_text() == ""
    assert (sysroot / "usr/bin/beta").is_file()

print("Component install cleanup, ownership, failure, and parallel Make tests passed.")
