#!/usr/bin/env python3

import json
from pathlib import Path
import subprocess
import tempfile


repository = Path(__file__).resolve().parents[3]
fixture = repository / "ci/tests/build-system/fixtures/native-tests"


def run(*command, expected=0):
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    assert result.returncode == expected, result.stdout
    assert "jobserver unavailable" not in result.stdout, result.stdout
    return result.stdout


def discover(build, configuration):
    return json.loads(run("ctest", "--test-dir", str(build), "-C", configuration, "--show-only=json-v1"))


def properties(test):
    return {item["name"]: item["value"] for item in test.get("properties", [])}


with tempfile.TemporaryDirectory(prefix="native tests with spaces ") as temporary:
    for configuration in ("Debug", "Release"):
        build = Path(temporary) / configuration
        run("cmake", "-S", str(fixture), "-B", str(build), "-G", "Unix Makefiles",
            "-DTEST_REPOSITORY=" + str(repository), "-DCMAKE_BUILD_TYPE=" + configuration)
        run("make", "-C", str(build), "-j4", "all-build-tests")
        parent = discover(build, configuration)
        imported = {test["name"]: test for test in parent["tests"]}
        direct_count = 0
        for component in ("alpha", "beta"):
            child = build / (component + "-prefix/src/" + component + "-build")
            direct = discover(child, configuration)
            direct_count += len(direct["tests"])
            for test in direct["tests"]:
                name = component + " :: " + test["name"]
                assert imported[name].get("command") == test.get("command"), name
                expected = properties(test)
                for prop in ("DEPENDS", "FIXTURES_REQUIRED", "FIXTURES_SETUP", "FIXTURES_CLEANUP"):
                    if prop in expected:
                        expected[prop] = [component + " :: " + value for value in expected[prop]]
                expected["LABELS"] = sorted(set(["native", component] + expected.get("LABELS", [])))
                actual = properties(imported[name])
                actual["LABELS"] = sorted(actual["LABELS"])
                assert actual == expected, (name, actual, expected)
            run("ctest", "--test-dir", str(child), "-C", configuration,
                "--output-on-failure", "-E", "actual-failure$", "-j4")
            output = run("ctest", "--test-dir", str(child), "-C", configuration,
                "--output-on-failure", "-R", "actual-failure$", expected=8)
            assert "Failed" in output
            # Caller/library options stay intact; only test executables undo NDEBUG.
            executable_flags = (child / "test/CMakeFiles/unit--arithmetic.test.dir/flags.make").read_text()
            library_flags = (child / "CMakeFiles/fixture-library.dir/flags.make").read_text()
            assert "-UNDEBUG" in executable_flags and "-UNDEBUG" not in library_flags
        assert len(imported) == direct_count
        run("ctest", "--test-dir", str(build), "-C", configuration,
            "--output-on-failure", "-E", "actual-failure$", "-j4")
        failed = run("ctest", "--test-dir", str(build), "-C", configuration,
            "--output-on-failure", "-R", "actual-failure$", expected=8)
        assert "2 tests failed" in failed and "alpha :: actual-failure" in failed and "beta :: actual-failure" in failed
        run("ctest", "--test-dir", str(build), "-C", configuration,
            "--output-on-failure", "-L", "command", "-j4")
        before = (build / "ctest_trampoline.cmake").stat().st_mtime_ns
        run("cmake", "-S", str(fixture), "-B", str(build), "-DTEST_REPOSITORY=" + str(repository))
        assert (build / "ctest_trampoline.cmake").stat().st_mtime_ns == before
        assert discover(build, configuration)["tests"] == parent["tests"]

print("Native tests preserve names, argv, properties, fixtures, failures, and optimized assertions through the parent.")
