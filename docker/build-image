#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "${self_dir}" rev-parse --show-toplevel)

# shellcheck source=docker/build-environment.conf
source "${self_dir}/build-environment.conf"

unpruned_image=$("${self_dir}/image-ref" unpruned)
pruned_image=$("${self_dir}/image-ref" pruned)
unpruned_repository=${unpruned_image%:*}
pruned_repository=${pruned_image%:*}
container="reaveros-docker-build-${$}"

cleanup()
{
    docker rm -f "${container}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker pull "${reaveros_build_environment_base_image}"

packages=$(printf ' %q' "${reaveros_build_environment_packages[@]}")
docker run \
    --name "${container}" \
    --volume "${repo_root}:/reaveros:ro" \
    "${reaveros_build_environment_base_image}" \
    /usr/bin/env bash -c "
        set -euo pipefail
        apt-get update
        apt-get install --yes${packages}
        apt-get full-upgrade --yes
        apt-get clean

        mkdir /build
        /reaveros/docker/build-toolchain
    "

docker export "${container}" \
    | docker import --change 'CMD ["/usr/bin/env", "bash"]' - "${unpruned_image}"

docker tag "${unpruned_image}" "${unpruned_repository}:latest"
"${self_dir}/prune-image" "${unpruned_image}" "${pruned_image}"
docker tag "${pruned_image}" "${pruned_repository}:latest"
