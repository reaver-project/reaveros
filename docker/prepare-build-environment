#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=docker/build-environment.conf
source /reaveros/docker/build-environment.conf

if ! grep -Fxq 'ID=debian' /etc/os-release \
    || ! grep -Fxq "VERSION_CODENAME=${reaveros_build_environment_release}" /etc/os-release
then
    printf 'The build-environment image does not use Debian %s.\n' \
        "${reaveros_build_environment_release}" >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive
printf 'deb http://deb.debian.org/debian %s-backports main\n' \
    "${reaveros_build_environment_release}" \
    > /etc/apt/sources.list.d/reaveros-backports.list
apt-get update
apt-get install --yes "${reaveros_build_environment_packages[@]}"
apt-get install --yes --target-release "${reaveros_build_environment_release}-backports" \
    "${reaveros_build_environment_backports_packages[@]}"
apt-get full-upgrade --yes
apt-get clean

/usr/bin/env bash /reaveros/docker/verify-build-environment-packages
