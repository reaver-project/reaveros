#!/usr/bin/env bash

set -euo pipefail

mode=build
defer_llvm=false

while [[ $# -gt 0 ]]
do
    case $1 in
        --defer-llvm)
            defer_llvm=true
            ;;
        --update)
            mode=update
            ;;
        --probe)
            mode=probe
            ;;
        *)
            printf 'usage: %s [--update [--defer-llvm]|--probe]\n' "$0" >&2
            exit 2
            ;;
    esac
    shift
done

if [[ ${mode} != update ]] && ${defer_llvm}
then
    printf '%s: --defer-llvm requires --update\n' "$0" >&2
    exit 2
fi

build_directory=${REAVEROS_BUILD_DIRECTORY:-/build}
source_directory=${REAVEROS_SOURCE_DIRECTORY:-/reaveros}
cache_configuration=()
if [[ -n ${REAVER_PROJECT_SCCACHE_CONTAINER_DIR:-} ]]
then
    cache_directory=${REAVER_PROJECT_SCCACHE_CONTAINER_DIR}
    if [[ ${cache_directory} != /run/reaver-project/compiler-cache \
        || ! -x ${cache_directory}/sccache \
        || ! -f ${cache_directory}/LICENSE \
        || ! -S ${cache_directory}/sccache.sock ]]
    then
        printf 'The container compiler-cache client or socket is unavailable.\n' >&2
        exit 1
    fi
    install -m 0755 "${cache_directory}/sccache" /usr/local/bin/sccache
    install -d /usr/share/doc/sccache
    install -m 0644 "${cache_directory}/LICENSE" /usr/share/doc/sccache/LICENSE
    cache_configuration=(-DREAVEROS_CACHE_PROGRAM=sccache)
fi
cd "${build_directory}"
cmake "${source_directory}" -DREAVEROS_ENABLE_UNIT_TESTS=ON \
    "${cache_configuration[@]}"

if [[ ${mode} == build ]]
then
    exec make all-toolchain -j"$(nproc)"
fi

target_rebuild_commands()
{
    target=$1
    make --dry-run --no-print-directory "${target}"
}

all_toolchain_commands=$(target_rebuild_commands all-toolchain)
llvm_commands=$(target_rebuild_commands toolchain-llvm)

all_toolchain=false
llvm=false
if grep --extended-regexp --quiet \
    "Performing (download|update|patch|configure|build|install) step for '" \
    <<<"${all_toolchain_commands}"
then
    all_toolchain=true
fi
if grep --fixed-strings --quiet \
    "Performing build step for 'toolchain-llvm'" \
    <<<"${llvm_commands}"
then
    llvm=true
fi

printf 'Toolchain rebuild required: %s\n' "${all_toolchain}"
printf 'LLVM rebuild required: %s\n' "${llvm}"

if [[ ${mode} == probe ]]
then
    printf 'reaveros_llvm_rebuild=%s\n' "${llvm}"
    exit 0
fi

if ${defer_llvm} && ${llvm}
then
    printf 'reaveros_update_result=deferred\n'
    exit 0
fi

/usr/bin/env bash /reaveros/docker/prepare-build-environment
make all-toolchain -j"$(nproc)"
/usr/bin/env bash /reaveros/docker/verify-build-environment-packages
printf 'reaveros_update_result=updated\n'
