#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 2 ]]
then
    printf 'usage: %s <unpruned image> <pruned image>\n' "$0" >&2
    exit 2
fi

unpruned_image=$1
pruned_image=$2
self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
# shellcheck source=docker/compiler-cache.sh
source "${self_dir}/compiler-cache.sh"
reaver_project_compiler_cache_options
container="reaveros-docker-prune-${$}"

cleanup()
{
    docker rm -f "${container}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker run --name "${container}" \
    --volume "${repo_root}:/reaveros:ro" \
    "${reaver_project_compiler_cache_args[@]}" \
    "${unpruned_image}" /usr/bin/env bash -c '
    set -euo pipefail
    cd /build
    make all-toolchain-prune -j"$(nproc)"
    /usr/bin/env bash /reaveros/docker/verify-build-environment-packages
'

docker export "${container}" \
    | "${self_dir}/import-build-environment" "${pruned_image}"
