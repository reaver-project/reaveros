#!/usr/bin/env python3

import os
from pathlib import Path
import shutil
import subprocess
import sys

from reproducibility import normalize_paths, packaging_environment


def main():
    if len(sys.argv) != 7:
        raise ValueError("usage: create-initrd <services> <runtime> <staging> <image> <find> <cpio>")
    services, runtime, staging, image = map(Path, sys.argv[1:5])
    find, cpio = sys.argv[5:]
    env = packaging_environment()
    temporary = Path(str(image) + ".tmp")
    try:
        if staging.exists():
            shutil.rmtree(staging)
        shutil.copytree(services, staging, symlinks=True)
        shutil.copyfile(runtime, staging / "librosestd.so")
        listed = subprocess.check_output([find, ".", "-print0"], cwd=staging, env=env)
        if not listed.endswith(b"\0"):
            raise ValueError("find did not produce a null-terminated pathname list")
        names = sorted(listed[:-1].split(b"\0"))
        normalize_paths(staging, [os.fsdecode(name) for name in names], int(env["SOURCE_DATE_EPOCH"]))
        image.parent.mkdir(parents=True, exist_ok=True)
        with temporary.open("wb") as output:
            subprocess.run([cpio, "--null", "--no-absolute-filenames", "--format=newc", "--create",
                "--reproducible", "--owner=0:0"], input=b"\0".join(names) + b"\0",
                stdout=output, cwd=staging, env=env, check=True)
        temporary.replace(image)
    finally:
        temporary.unlink(missing_ok=True)


try:
    main()
except (OSError, ValueError, subprocess.CalledProcessError) as error:
    sys.exit("Initrd packaging: " + str(error))
