#!/usr/bin/env python3

from pathlib import Path
import stat
import struct
import sys


def fail(message):
    sys.exit("UEFI image capacity: " + message)


def rounded_units(size, unit):
    return (size + unit - 1) // unit


def directory_entries(name):
    # Reserve a short entry and LFN entries regardless of mtools' case policy.
    # The fixed image layout fits every directory in one cluster either way.
    return 1 + rounded_units(len(name.encode("utf-16le")) // 2, 13)


def payload_clusters(directory, cluster_size, root_entries=None):
    entries = 1 if root_entries is not None else 2  # label, or . and ..
    clusters = 0
    for path in directory.iterdir():
        entries += directory_entries(path.name)
        mode = path.lstat().st_mode
        if stat.S_ISDIR(mode):
            clusters += payload_clusters(path, cluster_size)
        elif stat.S_ISREG(mode):
            clusters += rounded_units(path.stat().st_size, cluster_size)
        else:
            fail(f"unsupported staged payload: {path}")
    if root_entries is not None:
        if entries > root_entries:
            fail(f"root directory needs {entries} entries; only {root_entries} available")
    else:
        clusters += max(1, rounded_units(entries * 32, cluster_size))
    return clusters


def main():
    if len(sys.argv) != 5:
        fail("usage: check-fat-capacity <fresh image> <staging directory> <image bytes> <sector bytes>")
    image, staging = map(Path, sys.argv[1:3])
    capacity, alignment = map(int, sys.argv[3:])
    if capacity <= 0 or alignment <= 0 or capacity % alignment:
        fail("image capacity must be a positive whole number of sectors")
    if image.stat().st_size != capacity:
        fail(f"image size differs from the declared {capacity}-byte layout")
    with image.open("rb") as stream:
        boot = stream.read(512)
    if len(boot) != 512 or boot[510:512] != b"\x55\xaa":
        fail("mkfs did not produce a FAT boot sector")
    sector_size, sectors_per_cluster, reserved, fats, root_entries, sectors = struct.unpack_from("<HBHBHH", boot, 11)
    fat_sectors = struct.unpack_from("<H", boot, 22)[0]
    sectors = sectors or struct.unpack_from("<I", boot, 32)[0]
    if (sector_size != alignment or sectors * sector_size != capacity
            or not sectors_per_cluster or sectors_per_cluster & (sectors_per_cluster - 1)
            or not reserved or not fats or not root_entries or not fat_sectors):
        fail("formatted geometry differs from the declared FAT12/16 layout")
    root_sectors = rounded_units(root_entries * 32, sector_size)
    data_sectors = sectors - reserved - fats * fat_sectors - root_sectors
    available = data_sectors // sectors_per_cluster
    if not 0 < available < 65525:
        fail("formatted data region is not FAT12/16")
    cluster_size = sector_size * sectors_per_cluster
    required = payload_clusters(staging, cluster_size, root_entries)
    if required > available:
        fail(f"payload needs {required} clusters ({required * cluster_size} bytes); "
            f"only {available} clusters ({available * cluster_size} bytes) available "
            f"in the {capacity}-byte image")
    print(f"UEFI image capacity: {required}/{available} clusters used ({cluster_size} bytes each).")


try:
    main()
except (OSError, ValueError, struct.error) as error:
    fail(str(error))
