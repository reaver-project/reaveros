include("${CMAKE_CURRENT_LIST_DIR}/targets.cmake")
if (NOT _reaveros_toolchain_architecture IN_LIST _reaveros_architectures
        OR NOT _reaveros_toolchain_mode IN_LIST _reaveros_modes)
    message(FATAL_ERROR "Unsupported ReaverOS toolchain target: ${_reaveros_toolchain_architecture}/${_reaveros_toolchain_mode}")
endif()

set(REAVEROS_BUILD_MODE "${_reaveros_toolchain_mode}")
set(REAVEROS_IS_FREESTANDING FALSE)
set(REAVEROS_IS_UEFI FALSE)
if (REAVEROS_BUILD_MODE STREQUAL "freestanding" OR REAVEROS_BUILD_MODE STREQUAL "uefi")
    set(REAVEROS_IS_FREESTANDING TRUE)
endif()
if (REAVEROS_BUILD_MODE STREQUAL "uefi")
    set(REAVEROS_IS_UEFI TRUE)
endif()

set(CMAKE_SYSTEM_NAME "${_reaveros_${REAVEROS_BUILD_MODE}_system}")
set(CMAKE_SYSTEM_PROCESSOR "${_reaveros_${_reaveros_toolchain_architecture}_processor}")
set(triple "${_reaveros_${_reaveros_toolchain_architecture}_${REAVEROS_BUILD_MODE}_target}")
set(tools "@REAVEROS_BINARY_DIR@/install/toolchain/llvm/bin")
set(_reaveros_sysroot "@REAVEROS_BINARY_DIR@/install/sysroots/${_reaveros_toolchain_architecture}-${REAVEROS_BUILD_MODE}")
if (REAVEROS_BUILD_MODE STREQUAL "tests")
    # Tests overlay project artifacts on the native Linux environment.
    set(fake_sysroot "${_reaveros_sysroot}")
    set(clang_target_dirs "@REAVEROS_BINARY_DIR@/install/toolchain/llvm/include/${triple}/c++/v1")
    set(libcxx_lib_dir "@REAVEROS_BINARY_DIR@/install/toolchain/llvm/lib/${triple}")
    set(REAVEROS_ENABLE_UNIT_TESTS TRUE)
else()
    set(CMAKE_SYSROOT "${_reaveros_sysroot}")
endif()

set(CMAKE_C_COMPILER "${tools}/clang")
set(CMAKE_CXX_COMPILER "${tools}/clang++")
set(CMAKE_ASM_COMPILER "${tools}/clang")
foreach (_language IN ITEMS C CXX ASM)
    set(CMAKE_${_language}_COMPILER_TARGET "${triple}")
endforeach()
set(CMAKE_OBJCOPY "${tools}/llvm-objcopy")
set(CMAKE_READELF "${tools}/llvm-readelf")
