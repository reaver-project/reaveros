#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 3 ]]
then
    printf 'usage: %s <source directory> <tag> <revision>\n' "$0" >&2
    exit 2
fi

source_directory=$1
tag=$2
revision=$3

if [[ ! ${tag} =~ ^[[:alnum:]_.-]+$ || ! ${revision} =~ ^[0-9a-f]{40}$ ]]
then
    printf 'Invalid Git tag or revision.\n' >&2
    exit 2
fi

local_revision=$(git -C "${source_directory}" rev-parse --verify --quiet "refs/tags/${tag}^{commit}" || true)
if [[ ${local_revision} == "${revision}" ]]
then
    printf 'Already have %s at %s; skipping fetch.\n' "${tag}" "${revision}"
else
    git -C "${source_directory}" fetch --force --depth=1 origin "refs/tags/${tag}:refs/tags/${tag}"
    fetched_revision=$(git -C "${source_directory}" rev-parse --verify "refs/tags/${tag}^{commit}")
    if [[ ${fetched_revision} != "${revision}" ]]
    then
        printf 'Tag %s resolves to %s, not configured revision %s.\n' \
            "${tag}" "${fetched_revision}" "${revision}" >&2
        exit 1
    fi
fi

git -C "${source_directory}" checkout "${tag}"
