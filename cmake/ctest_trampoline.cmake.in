include("@REAVEROS_SOURCE_DIR@/cmake/ctest_discovery.cmake")
set(components @components@)
@properties_for_trampoline@

if (NOT "${CTEST_CONFIGURATION_TYPE}" STREQUAL "")
    set(_configuration "${CTEST_CONFIGURATION_TYPE}")
else()
    set(_configuration "@CMAKE_BUILD_TYPE@")
endif()
foreach (component IN LISTS components)
    reaveros_import_native_tests(
        COMPONENT "${component_names_${component}}"
        BINARY_DIR "${component_directory_${component}}"
        CTEST "@REAVEROS_CTEST@" CONFIGURATION "${_configuration}"
        LABELS ${component_labels_${component}}
    )
endforeach()
